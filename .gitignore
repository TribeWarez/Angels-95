PLAN_STUBS_*.scratch
build/
build-ed/

# Tool build output / python caches
worldcheck
worldcheck.exe
__pycache__/
*.pyc

# Orchestrator deepwork session state (git-local but OpenCode-readable)
.slim/deepwork/

# VS Code extension packaging output (tools/vscode/package-vsix.ps1)
tools/vscode/dist/
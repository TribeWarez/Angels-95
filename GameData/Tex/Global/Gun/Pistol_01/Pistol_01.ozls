entity "pistol_01" : weapon {
    mesh = "FbxFiles/Pistol_01.glb"
    texture = "Textures/Pistol_01_Albedo.png"
    icon = "Textures/Pistol_01_silhouette.png"
    // Rigged with Idle/Fire/Reload; see Rifle_01.ozls. This drives the world
    // pickup only (DrawEntities applies anim_idle), not the view-model.
    mesh_type = "skeletal"
    anim_idle = "Idle"
    stats {
        damage = 14
        fire_rate = 0.28
        projectile_speed = 55.0
        projectile_lifetime = 2.0
        projectile_count = 1
        spread = 0.7
        magazine = 15
        reload_time = 1.4
        recoil = 1.6
        projectile_mesh = GameData/Tex/Global/Gun/Projectiles/FbxFile/Projectiles.glb
        projectile_submesh = 2
        projectile_scale = 14.0
        projectile_color = (1.0, 0.85, 0.35)
        // Held-size convention (ViewModel.cpp): viewmodel_scale multiplies a fit
        // that normalises the LONGEST axis, so it is effectively the held length
        // relative to a 0.55-unit rifle - not a uniform scale. A pistol is far
        // smaller in the hand than a rifle, and the old 1.0 made it exactly as
        // long as one; the forward offset is also chosen so the grip's near end
        // stays ~0.5 units from the eye instead of 0.17, which is what produced
        // the enormous, fish-eyed "gun in your face" look.
        viewmodel_offset = (0.28, -0.23, 0.68)
        viewmodel_rot = (0, 110, 0)
        viewmodel_scale = 0.62
        // Sound stats: quote-free, space-free asset paths.
        fire_sound = GameData/Audio/Sounds/Guns/machgf3b.wav
        fire_volume = 0.9
    }
    actions {
        on_fire {
            set_cooldown 0.28
        }
        on_reload {
            say "Reloading pistol..."
        }
    }
}

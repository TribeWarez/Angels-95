entity "shotgun_01" : weapon {
    mesh = "FbxFiles/Shotgun_01.glb"
    texture = "Textures/Shotgun_01_Albedo.png"
    icon = "Textures/Shotgun_01_silhouette.png"
    // Rigged with Idle/Fire/Reload clips. The pack authors the reload as two
    // takes (ReloadStep + ReloadEnd); tools/convert_fbx.ps1 concatenates them
    // into the single "Reload" clip the engine plays.
    mesh_type = "skeletal"
    anim_idle = "Idle"
    stats {
        // Eight pellets x 9 damage. Point blank that is 72, which one-shots a
        // Walker (60 hp) - the intended reward for closing the distance - and
        // falls off fast because the pellets spread and the lifetime is short.
        damage = 9
        fire_rate = 0.85
        projectile_speed = 55.0
        projectile_lifetime = 1.2
        projectile_count = 8
        // Per-pellet angular step: 8 pellets at 2 degrees covers about +-7
        // degrees around the aim line, plus the per-pellet random yaw jitter.
        spread = 2.0
        magazine = 6
        // Matches the concatenated Reload clip (1.767 s).
        reload_time = 1.8
        recoil = 4.2
        // Buckshot projectile submesh.
        projectile_mesh = GameData/Tex/Global/Gun/Projectiles/FbxFile/Projectiles.glb
        projectile_submesh = 6
        projectile_scale = 9.0
        projectile_color = (1.0, 0.78, 0.42)
        // Same held-size convention as Rifle_01.ozls (a shotgun is rifle-length).
        viewmodel_offset = (0.32, -0.26, 0.77)
        viewmodel_rot = (0, 110, 0)
        viewmodel_scale = 0.95
        // Sound stats: quote-free, space-free asset paths. The heaviest weapon,
        // so the lowest pitch and the loudest report.
        fire_sound = GameData/Audio/Sounds/Guns/machgf3b.wav
        fire_volume = 1.0
        fire_pitch = 0.72
        reload_sound = GameData/Audio/Sounds/Entities/weapload.wav
    }
    actions {
        on_fire {
            set_cooldown 0.85
        }
        on_reload {
            say "Reloading shotgun..."
        }
    }
}

entity "rifle_01" : weapon {
    mesh = "Fbx_Files/Rifle_01.glb"
    texture = "Textures/Rifle_01_Albedo.png"
    icon = "Textures/Rifle_01_silhouette.png"
    // The GLB is rigged with Idle/Fire/Reload clips. `mesh_type = "skeletal"`
    // makes the WORLD PICKUP use them (PawnSystem::DrawEntities plays anim_idle
    // on a dropped weapon); the view-model picks its own path via
    // viewmodel_skeletal, so this does not affect the held gun. Before this the
    // pickup was loaded as a static mesh and stood in its bind pose.
    mesh_type = "skeletal"
    anim_idle = "Idle"
    stats {
        damage = 20
        fire_rate = 0.12
        projectile_speed = 70.0
        projectile_lifetime = 2.4
        projectile_count = 1
        spread = 1.2
        magazine = 30
        reload_time = 1.9
        recoil = 2.2
        projectile_mesh = GameData/Tex/Global/Gun/Projectiles/FbxFile/Projectiles.glb
        projectile_submesh = 4
        projectile_scale = 8.0
        projectile_color = (0.6, 1.0, 0.4)
        viewmodel_offset = (0.3, -0.22, 0.55)
        viewmodel_rot = (0, 90, 0)
        viewmodel_scale = 1.3
        // Sound stats: quote-free, space-free asset paths. Heavier and lower
        // than the pistol via pitch, reusing the one shipped gunshot wav.
        fire_sound = GameData/Audio/Sounds/Guns/machgf3b.wav
        fire_volume = 1.0
        fire_pitch = 0.85
        reload_sound = GameData/Audio/Sounds/Entities/weapload.wav
    }
    actions {
        on_fire {
            set_cooldown 0.12
        }
        on_reload {
            say "Reloading rifle..."
        }
    }
}

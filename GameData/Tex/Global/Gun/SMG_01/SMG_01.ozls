entity "smg_01" : weapon {
    mesh = "Fbx_Files/SMG_01.glb"
    texture = "Textures/SMG_01_Albedo.png"
    icon = "Textures/SMG_01_silhouette.png"
    // Rigged with Idle/Fire/Reload clips (see Rifle_01.ozls): `mesh_type =
    // "skeletal"` drives the WORLD PICKUP, which plays anim_idle through
    // PawnSystem::DrawEntities. The held copy is the view-model's own path.
    mesh_type = "skeletal"
    anim_idle = "Idle"
    stats {
        // The spray weapon: least damage per round, highest rate of fire and
        // the largest magazine, so it trades accuracy for sustained pressure.
        damage = 10
        fire_rate = 0.075
        projectile_speed = 62.0
        projectile_lifetime = 1.8
        projectile_count = 1
        spread = 2.6
        magazine = 32
        // Matches the merged Reload clip exactly (2.25 s), so the animation
        // finishes as the magazine refills.
        reload_time = 2.25
        recoil = 1.1
        // 9mm projectile, same submesh the pistol fires.
        projectile_mesh = GameData/Tex/Global/Gun/Projectiles/FbxFile/Projectiles.glb
        projectile_submesh = 2
        projectile_scale = 12.0
        projectile_color = (1.0, 0.92, 0.55)
        // See ViewModel.cpp: the fit scale normalises the longest axis, so this
        // is a relative multiplier (rifle 1.3, pistol 1.0). Slightly under the
        // rifle, so the SMG reads as the smaller, lighter weapon.
        viewmodel_offset = (0.26, -0.2, 0.5)
        viewmodel_rot = (0, 90, 0)
        viewmodel_scale = 1.15
        // Sound stats: quote-free, space-free asset paths. Pitched up from the
        // rifle's shot to read as a lighter, faster weapon.
        fire_sound = GameData/Audio/Sounds/Guns/machgf3b.wav
        fire_volume = 0.8
        fire_pitch = 1.2
        reload_sound = GameData/Audio/Sounds/Entities/weapload.wav
    }
    actions {
        on_fire {
            set_cooldown 0.075
        }
        on_reload {
            say "Reloading SMG..."
        }
    }
}

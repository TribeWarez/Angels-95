entity "etheral_waver" : weapon {
    mesh = "EtheralWeaver_Sword.glb"
    texture = "EtheralWeaverTex.png"
    icon = "etheral_waver_icon.png"
    stats {
        damage = 55
        swing_speed = 0.7
        reach = 3.5
        stamina_cost = 18
        viewmodel_offset = (0.30, -0.26, 0.52)
        viewmodel_rot = (0, 90, 0)
        viewmodel_scale = 1.0
        // Same reason as selenite_blade: the source GLB is ~9.9 units long
        // (authored with a 100/100/64.8 node scale), which the viewmodel Fit
        // handles but the 1.5x world pickup does not - it rendered ~15 units
        // tall. 1.5 * 0.08 * 9.9 = 1.19 units.
        mesh_scale = 0.08
        // Melee sound stats. swing_sound plays on every swing; hit_sound only
        // on a connect that is not blocked by geometry (see FireSelectedWeapon).
        swing_sound = GameData/Audio/Sounds/Entities/boot1.wav
        swing_volume = 0.7
        hit_sound = GameData/Audio/Sounds/Entities/Hurt.mp3
        hit_volume = 0.8
    }
    actions {
        on_swing {
            say "Etheral slash!"
            set_cooldown 0.7
        }
        on_hit {
            say "Spectral hit!"
        }
    }
}

entity "automag" : weapon {
    mesh = "automag_lvl1.obj"
    texture = "automag_lvl1_texture.png"
    stats {
        damage = 15
        fire_rate = 0.4
        range = 50.0
        magazine = 12
        reload_time = 2.0
        // The source OBJ is 2.7 units long (a 0.3-unit SMG scaled up); the
        // world pickup draws it unfitted at 1.5x. 1.5 * 0.3 * 2.7 = 1.22 units.
        mesh_scale = 0.3
        // Sound stats: quote-free, space-free asset paths.
        fire_sound = GameData/Audio/Sounds/Guns/machgf3b.wav
        fire_volume = 0.95
    }
    actions {
        on_fire {
            say "Bang! (15 damage)"
            set_cooldown 0.4
        }
        on_reload {
            say "Reloading..."
        }
    }
    // Variants are resolved at Spawn by picking the highest tier whose "lvlN"
// name does not exceed the player's level. lvl2 pointed at "automag_lvl2",
// which does not exist - the shipped mesh is automag_lvl2_alt.obj.
variants {
        "lvl1" { mesh_override = "automag_lvl1.obj" }
        "lvl2" { mesh_override = "automag_lvl2_alt.obj" }
        "lvl3" { mesh_override = "automag_heavy_rifle_lvl3.obj" }
    }
}

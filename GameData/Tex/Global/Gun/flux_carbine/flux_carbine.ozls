entity "flux_carbine" : weapon {
    mesh = "GameData/Tex/Global/Gun/automag/automag_lvl2_alt.obj"
    texture = "GameData/Tex/Global/Gun/automag/automag_lvl1_texture.png"
    icon = "GameData/Tex/Global/Models/Object1Icon.png"
    stats {
        // 4.4-unit source mesh; see automag. 1.5 * 0.2 * 4.4 = 1.32 units.
        mesh_scale = 0.2
        damage = 18
        fire_rate = 0.18
        projectile_speed = 24.0
        projectile_lifetime = 2.5
        magazine = 24
        reload_time = 1.6
        spread = 2.0
        // Sound stats: quote-free, space-free asset paths. The fastest-firing
        // weapon, so pitched up a little to separate it from the rifle.
        fire_sound = GameData/Audio/Sounds/Guns/machgf3b.wav
        fire_volume = 0.85
        fire_pitch = 1.15
    }
    actions {
        on_reload {
            say "Flux carbine vents — reloading."
        }
    }
}
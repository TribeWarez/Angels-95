entity "Player" : upgrade {
    // Player character model used to render players in the world.
    // Plague Arcanist: rigged GLB with its own embedded textures, so `texture` is
    // omitted (PlayerModel only falls back to the legacy PNG for the default mesh).
    // The 10 embedded clips are unnamed-in-meaning mixamo takes, but their names
    // are real ("Armature|Armature.00N|...", truncated to 31 chars by raylib's
    // char[32] ModelAnimation.name). The two used here were picked by measuring
    // each take's joint motion: .002 is the calmest loop (idle) and .008 has the
    // highest leg cadence (a step cycle). Both are safe to change here.
    mesh = "GameData/Pawn/Player/Plague_Arcanist.glb"
    mesh_type = "skeletal"
    anim_idle = "Armature.002"
    anim_chase = "Armature.008"
    // Base walk-speed multiplier (sprint/crouch scale this at runtime).
    movement_speed = 1.4
    stats {
        // Rendered height in engine units for remote-player bodies. The character
        // GLBs are authored in metres while the collision box (PlayerMovement::
        // Height) is 3.0, so without this every online player drew at roughly half
        // the size of their own silhouette. Any positive value re-normalises to it;
        // a NEGATIVE value means "draw at the authored scale, do not normalise".
        //
        // MUST stay inside stats { }: PlayerModel reads stats.floats, and a
        // top-level key here is dropped by the parser (with a warning).
        model_height = 3.0
        health = 100
        max_health = 100
        mana = 0
        max_mana = 100
        psychic_energy = 0
        max_psychic_energy = 100
        level = 1
        xp = 0
        xp_to_next = 100
        // Sound stats. Paths are resolved def-relative first, then via the
        // package loader, so these work loose or inside a .ozsnd package.
        // Quote-free and space-free: the stats parser stores a string value
        // verbatim and a single embedded space silently truncates it.
        jump_sound = GameData/Audio/Sounds/Entities/jump1.wav
        land_sound = GameData/Audio/Sounds/Entities/land.wav
        hurt_sound = GameData/Audio/Sounds/Entities/Hurt.mp3
        // death_sound intentionally left unauthored so a fatal hit keeps the
        // preloaded death handle; set it to override.
        walk_volume = 0.8
        jump_volume = 0.9
    }
}

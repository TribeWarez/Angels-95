// Psychic Surge - a heavy single bolt on psychic energy. The expensive
// alternative to Arc Bolt: roughly four times the damage for about four times
// the cost, so it is a burst tool rather than a sustained one.
entity "psychic_surge" : spell {
    icon = "GameData/Tex/Global/Skills/psychic_surge.png"
    stats {
        cost_type = psychic_energy
        pe_cost = 60
        cooldown = 3.0
        damage = 95
        projectile_speed = 36.0
        projectile_lifetime = 2.4
        projectile_count = 1
        projectile_scale = 1.6
        projectile_color = (0.85, 0.45, 1.0)
        element = psychic
        cast_sound = GameData/Audio/Sounds/Skills/psychic_surge.wav
        cast_volume = 1.0
    }
    actions {
        on_cast { say "Psychic Surge!" }
    }
}
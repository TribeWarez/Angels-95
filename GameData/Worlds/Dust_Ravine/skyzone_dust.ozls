entity "dust_sky" : skyzone {
    fog_color = (0.82, 0.68, 0.52)
    fog_density = 0.006
    ambient_light = (0.55, 0.50, 0.45)
    skybox = "GameData/Tex/Global/Sky/skydome_daylight.png"
    actions {
        on_enter {
            set_fog 0.82 0.68 0.52 0.006
            set_ambient 0.55 0.50 0.45
            set_skybox "GameData/Tex/Global/Sky/skydome_daylight.png"
            say "Dust Ravine - fortress ahead, enemies in every hall"
        }
        on_exit {
            restore_fog
            restore_skybox
            say "Left the Dust Ravine sky zone"
        }
    }
}

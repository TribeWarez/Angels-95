# --- Cliff rim: a 1.4-high broken rock lip along the plateau's east edge, with
# the stair mouth left open at y -3..3. Without it the "descent" is optional by
# accident - you could walk straight off the edge for an 18-unit drop, and this
# build has no fall damage. It reads the same as a natural rim, does not block
# the valley view (eye 19.8, lip 19.4), and makes leaving the plateau a
# deliberate choice (the stair, or a jump).
add box -70.6 -36.5 18.7 1.2 1.4 67 0 texPath=GameData/Tex/Tileset/Egypt/eg_mainstone_03.png texScaleU=0.5 texScaleV=2
add box -70.6 36.5 18.7 1.2 1.4 67 0 texPath=GameData/Tex/Tileset/Egypt/eg_mainstone_03.png texScaleU=0.5 texScaleV=2


# ===========================================================================
# THE MACHINE SCAR - optional branch behind the falls
# ===========================================================================
# The waterfall curtain is the door. Walk through the sheet (it is cosmetic,
# NO_BSP_CUTS) into a cut tunnel, then a three-way grotto:
#   north -> quantum vault (look at the seal to make it fail)
#   east  -> CRT control room (signal wound)
#   south -> reverse-gravity choir, with a ladder back down
# Every floor here is a real brush; there is no heightmap and no mesh collision.

# --- Tunnel through the backing rock -------------------------------------
add box 91 0 -1 10 2 12 0 texPath=GameData/Tex/Tileset/Egypt/eg_mainstone_01.png texScaleU=0.2 texScaleV=0.2

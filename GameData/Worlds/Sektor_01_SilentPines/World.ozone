add box -17.5 0 0.9 3 1.8 6 0 texPath=GameData/Tex/Tileset/Egypt/eg_mainstone_03.png texScaleU=1 texScaleV=1
add box -14.5 0 0.45 3 0.9 6 0 texPath=GameData/Tex/Tileset/Egypt/eg_mainstone_03.png texScaleU=1 texScaleV=1


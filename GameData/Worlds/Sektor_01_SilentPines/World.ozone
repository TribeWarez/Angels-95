# Undergrowth. The pack is a HEDGE KIT: each piece is a foliage card with an
# OPEN bottom (the texture is hedge_open_bottom - bare stems under the leaves),
# authored end-to-end with its origin at one end and +X along the run (~2.0
# long). A single card on its own reads as a floating leaf, so these are placed
# as runs: consecutive pieces 2.0 apart along their length, which makes them
# overlap into one continuous hedge. One season per run - alternating green and
# autumn cards inside one run reads as a patchwork.
# Season: this gorge is a green pine valley under a day sky, so the summer set
# is here; the snow maps keep the winter one. Shared home:
# GameData/Environment/Plant/Bushes.
# Hut A front: its south wall runs x 40..52 at y=-24 with the doorway at x 46..50,
# so the summer run covers the wall's west half and stops at the jamb.
Mesh.Static GameData/Environment/Plant/Bushes/bush_tall_summer.glb 40.9 -22.6 0 0 scale=1.15 wind=1
Mesh.Static GameData/Environment/Plant/Bushes/bush_tall_summer.glb 42.9 -22.6 0 0 scale=1.15 wind=1
Mesh.Static GameData/Environment/Plant/Bushes/bush_tall_summer.glb 44.9 -22.6 0 0 scale=1.15 wind=1
# Shrine garden: the autumn run up the platform's east side (platform x 59..75,
# so the hedge stands clear at x=76.8 on the east-bank floor).
Mesh.Static GameData/Environment/Plant/Bushes/bush_tall_autumn.glb 76.8 32.2 0 90 scale=1.15 wind=1
Mesh.Static GameData/Environment/Plant/Bushes/bush_tall_autumn.glb 76.8 34.2 0 90 scale=1.15 wind=1
Mesh.Static GameData/Environment/Plant/Bushes/bush_tall_autumn.glb 76.8 36.2 0 90 scale=1.15 wind=1
Mesh.Static GameData/Environment/Plant/Bushes/bush_tall_autumn.glb 76.8 38.2 0 90 scale=1.15 wind=1
# Loose shrubs. This is the VOLUMETRIC piece (three crossed cards, 12 tris), so
# unlike the hedge cards it reads as a bush standing on its own; scattered on
# both banks (x=17 is the river, x 74..86 the plunge pool, and the west bank
# carries the descent stair at |y| < 3).
Mesh.Static GameData/Environment/Plant/Bushes/bush_full_overgrown_summer.glb -85 -20 18 20 scale=1.9 wind=1
Mesh.Static GameData/Environment/Plant/Bushes/bush_full_overgrown_summer.glb -50 10 0 30 scale=1.9 wind=1
Mesh.Static GameData/Environment/Plant/Bushes/bush_full_overgrown_autumn.glb -35 25 0 120 scale=2.0 wind=1
Mesh.Static GameData/Environment/Plant/Bushes/bush_full_overgrown_summer.glb -10 30 0 210 scale=1.7 wind=1
Mesh.Static GameData/Environment/Plant/Bushes/bush_full_overgrown_autumn.glb 0 -30 0 300 scale=2.1 wind=1
Mesh.Static GameData/Environment/Plant/Bushes/bush_full_overgrown_summer.glb 30 15 0 45 scale=1.8 wind=1
Mesh.Static GameData/Environment/Plant/Bushes/bush_full_overgrown_autumn.glb 62 12 0 180 scale=2.0 wind=1
Mesh.Static GameData/Environment/Plant/Bushes/bush_full_overgrown_summer.glb 75 -45 0 260 scale=1.9 wind=1
Mesh.Static GameData/Environment/Plant/Bushes/bush_full_overgrown_autumn.glb 36 40 0 100 scale=1.8 wind=1
Mesh.Static GameData/Environment/Plant/Bushes/bush_full_overgrown_summer.glb 55 30 0 240 scale=2.0 wind=1
# Root flare at two pine trunks. The mesh is a 0.6-unit clump, so it is scaled

# --- Dirt decals on the valley floor (NO_BSP_CUTS: cosmetic, never collision) ---
# PNG, not the Jungle .jpg: raylib cannot decode those EXIF JPEGs (they load at
# the FILEIO layer and then fail with "Data format not supported", silently
# falling back to a flat colour).
add pln -40 10 0.06 0 0 1 0 texPath=GameData/Tex/Tileset/Egypt/eg_mainstone_03.png texScaleU=0.2 texScaleV=0.2 flags=268435456

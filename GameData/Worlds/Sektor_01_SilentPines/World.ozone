# --- Valley end ridges: low rock (12 tall) so the SKY stays visible. A taller
# painted ring at the bounds turned every sightline into a courtyard wall.
add box 0 72 5 224 12 2 0 texPath=GameData/Tex/Tileset/Egypt/eg_mainstone_04.png texScaleU=2 texScaleV=1
add box 0 -72 5 224 12 2 0 texPath=GameData/Tex/Tileset/Egypt/eg_mainstone_04.png texScaleU=2 texScaleV=1

# Entities
playerstart -80 0 18 90
playerstart 40 -55 0 0
pickup HealthVial -60 0 1 30
pickup ManaVial 40 -30 0.7 30
pickup rifle_01 30 20 0.7 30
pickup etheral_waver 67 37 1.9 30
pickup Ammo 17 0 1 30
pickup Medkit 60 -30 0.7 30
pickup Powerup 67 33 0.7 30
pickup Key 50 20 0.7 30
npc Skaarj -96 10 18
npc Walker -88 -8 18
npc Skaarj 0 20 0
npc Walker 20 -20 0
npc Brute 40 10 0
npc Walker 55 -10 0
npc Skaarj 70 20 0
npc Walker 30 -45 0
npc Floater 60 10 0
npc Walker 78 -30 0
npc Skaarj 67 40 0.6
npc Walker -30 40 0
light directional 60 40 90 255 240 205 0.85
light directional -45 -30 55 165 185 220 0.35
light point 60 30 2.2 255 170 70 0.7 14 effect=2
light point 74 30 2.2 255 170 70 0.7 14 effect=2
light point 60 44 2.2 255 170 70 0.7 14 effect=2
light point 74 44 2.2 255 170 70 0.7 14 effect=2
light point -14 0 2 200 215 255 0.5 16
light point 17 0 2.5 200 215 255 0.5 16

# Zones: names must match the sibling .ozls entity names exactly.
zone sky -112 -72 -6 112 72 46 1 name=silentpines_sky gravity=18 jump=9 terminal=60 water_gravity=8 water_drag=0.95 swim_up=5 ladder_speed=6 fly_mult=1.5
zone water 8 -70 -2 26 70 2 1 name=silentpines_river gravity=18 jump=9 terminal=60 water_gravity=7 water_drag=0.92 swim_up=4.5 ladder_speed=6 fly_mult=1.5
zone water 74 -12 -2 86 12 2 1 name=silentpines_pool gravity=18 jump=9 terminal=60 water_gravity=7 water_drag=0.92 swim_up=4.5 ladder_speed=6 fly_mult=1.5
zone reverb 59 29 0 75 45 9 1 name=silentpines_shrine gravity=18 jump=9 terminal=60 water_gravity=8 water_drag=0.95 swim_up=5 ladder_speed=6 fly_mult=1.5

# Threshold at the bridge approach (off both playerstarts).
trigger Trigger_EnterVolume -3 -9 0 -1 9 8 once
# Campaign exit behind the shrine. Spawn lands inside Sektor_02_MegacityGrid's floor.
portal Sektor_02_MegacityGrid 75 38 0 79 42 6 0 0 1 bidir

# Falls mist (direction is authored Z-up: 0 0 1 = up, negative gravity settles it)
ParticleEmitter mist 84 -4 0.2 18 2.5 1.8 22 0.2 1.8 230 235 240 190 200 215 -0.5 8 0 0 1 0
ParticleEmitter mist 84 4 0.2 18 2.5 1.8 22 0.2 1.8 230 235 240 190 200 215 -0.5 8 0 0 1 0
ParticleEmitter fire 60 30 1.4 26 0.8 2.6 10 0.35 0.05 255 175 70 255 60 0 -2 5 0 0 1 0
ParticleEmitter fire 74 30 1.4 26 0.8 2.6 10 0.35 0.05 255 175 70 255 60 0 -2 5 0 0 1 0
ParticleEmitter fire 60 44 1.4 26 0.8 2.6 10 0.35 0.05 255 175 70 255 60 0 -2 5 0 0 1 0
ParticleEmitter fire 74 44 1.4 26 0.8 2.6 10 0.35 0.05 255 175 70 255 60 0 -2 5 0 0 1 0


# OZONE world – Sektor_01_SilentPines (Terran Prime / Mission 1)
# NyLeve-style forested gorge: cliff-top arrival, stepped descent, river and
# bridge, waterfall into a plunge pool, Nali-style shrine ruins, pine valley.
# Format: ozone v1.0
# Hierarchy: Terran Prime -> Sefirah 1 -> Sektor_01_SilentPines
#
# All-brush terrain on purpose: collision is AABB-only, so cliffs and terraces
# are brushes (a heightmap would give walk-through cliff faces). Every walkable
# rise is 0.9 or less - kStepHeight is exactly 1.0 and a rise of 1.0 sits on the
# float boundary.
#
# Box arg order is  x y z  w h d  rot  where h is the VERTICAL size (Z) and d is
# the Y depth. OZONE is Z-up: authored z = height.
#
# UV NOTE: BuildBox multiplies the generated UVs by 16 (h >= 1.0) or 8 (thin),
# so an authored texScale is a MULTIPLIER on top of that. Values near 1 are
# correct here; the 8-14 range compounds into moire noise.
#
# Zone names are the lookup keys for the sibling .ozls defs in this directory;
# renaming one without re-keying its def silently drops fog/ambient at load.

# --- Arrival plateau (playerstart #1 sits at its edge, facing down the gorge) ---
add box -91 0 8 42 20 140 0 texPath=GameData/Worlds/EngineTest/oztex/tileset/05_grass_jungle_256.png texScaleU=3.5 texScaleV=3.5

# --- Valley floor: west bank / river bed / east bank (no sub: separate adds) ---
add box -31 0 -1 78 2 140 0 texPath=GameData/Worlds/EngineTest/oztex/tileset/05_grass_jungle_256.png texScaleU=3.5 texScaleV=3.5
add box 17 0 -2.2 18 2 140 0 texPath=GameData/Tex/Tileset/Egypt/eg_mainstone_03.png texScaleU=1.5 texScaleV=1.5
add box 50 0 -1 48 2 140 0 texPath=GameData/Worlds/EngineTest/oztex/tileset/05_grass_jungle_256.png texScaleU=3.5 texScaleV=3.5
add box 80 41 -1 12 2 58 0 texPath=GameData/Worlds/EngineTest/oztex/tileset/05_grass_jungle_256.png texScaleU=3.5 texScaleV=3.5
add box 80 -41 -1 12 2 58 0 texPath=GameData/Worlds/EngineTest/oztex/tileset/05_grass_jungle_256.png texScaleU=3.5 texScaleV=3.5


# OZONE world – Sektor_01_SilentPines (Terran Prime / Mission 1)
# NyLeve-style forested gorge: cliff-top arrival, stepped descent, river and
# bridge, waterfall into a plunge pool, Nali-style shrine ruins, pine valley.
# Format: ozone v1.0
# Hierarchy: Terran Prime -> Sefirah 1 -> Sektor_01_SilentPines
#
# All-brush terrain on purpose: collision is AABB-only, so cliffs and terraces
# are brushes (a heightmap would give walk-through cliff faces). Every walkable
# rise is 0.9 or less - kStepHeight is exactly 1.0 and a rise of 1.0 sits on the
# float boundary.
#
# Box arg order is  x y z  w h d  rot  where h is the VERTICAL size (Z) and d is
# the Y depth. OZONE is Z-up: authored z = height.
#
# UV NOTE: BuildBox multiplies the generated UVs by 16 (h >= 1.0) or 8 (thin),
# so an authored texScale is a MULTIPLIER on top of that. Values near 1 are
# correct here; the 8-14 range compounds into moire noise.
#
# Zone names are the lookup keys for the sibling .ozls defs in this directory;
# renaming one without re-keying its def silently drops fog/ambient at load.

# --- Arrival plateau (playerstart #1 sits at its edge, facing down the gorge) ---
add box -91 0 8 42 20 140 0 texPath=GameData/Worlds/EngineTest/oztex/tileset/05_grass_jungle_256.png texScaleU=3.5 texScaleV=3.5

# --- Valley floor: west bank / river bed / east bank (no sub: separate adds) ---
add box -31 0 -1 78 2 140 0 texPath=GameData/Worlds/EngineTest/oztex/tileset/05_grass_jungle_256.png texScaleU=3.5 texScaleV=3.5
add box 17 0 -2.2 18 2 140 0 texPath=GameData/Tex/Tileset/Egypt/eg_mainstone_03.png texScaleU=1.5 texScaleV=1.5
add box 56 0 -1 60 2 140 0 texPath=GameData/Worlds/EngineTest/oztex/tileset/05_grass_jungle_256.png texScaleU=3.5 texScaleV=3.5

# --- River: shallow, fast, scrolling along Y (PAN_V, not PAN_U) ---
add box 17 0 -0.55 18 0.3 140 0 texPath=GameData/Tex/Global/EFX/liquid_water.png texScaleU=1 texScaleV=4 flags=526464 surfAlpha=0.7 panV=0.12

# --- Bridge over the river: deck top 0.9, 0.45 landings so it is walk-up ---
add box 17 0 0.7 30 0.4 18 0 texPath=GameData/Tex/Tileset/Egypt/eg_mainstone_01.png texScaleU=1 texScaleV=1
add box 0.5 0 0.225 3 0.45 18 0 texPath=GameData/Tex/Tileset/Egypt/eg_mainstone_01.png texScaleU=0.6 texScaleV=1
add box 33.5 0 0.225 3 0.45 18 0 texPath=GameData/Tex/Tileset/Egypt/eg_mainstone_01.png texScaleU=0.6 texScaleV=1
add box 17 8.6 1.55 30 1.3 0.3 0 texPath=GameData/Tex/Tileset/Egypt/eg_mainstone_02.png texScaleU=1 texScaleV=0.5
add box 17 -8.6 1.55 30 1.3 0.3 0 texPath=GameData/Tex/Tileset/Egypt/eg_mainstone_02.png texScaleU=1 texScaleV=0.5

# --- East cliff split around the falls notch (y -8..8) ---
add box 89 39 13 6 26 62 0 texPath=GameData/Tex/Tileset/Egypt/eg_mainstone_04.png texScaleU=2 texScaleV=2
add box 89 -39 13 6 26 62 0 texPath=GameData/Tex/Tileset/Egypt/eg_mainstone_04.png texScaleU=2 texScaleV=2
# Rock face BEHIND the notch, so the water reads against dark stone and not sky.
add box 86.8 0 13 1.4 26 16 0 texPath=GameData/Tex/Tileset/Egypt/eg_mainstone_04.png texScaleU=1 texScaleV=1

# --- Waterfall sheet: just in front of the backing rock, translucent, scrolls down ---
# flags = UNLIT 2048 | TRANSLUCENT 128 | TWO_SIDED 1024 | PAN_V 524288 | NO_BSP_CUTS 268435456
add box 85.9 0 11 0.2 22 12 0 texPath=GameData/Tex/Global/EFX/liquid_water.png texScaleU=1 texScaleV=2 flags=268962944 surfAlpha=0.6 panV=-0.35

# --- Plunge pool ---
add box 80 0 -2.6 12 2 24 0 texPath=GameData/Tex/Tileset/Egypt/eg_mainstone_03.png texScaleU=1.5 texScaleV=1.5
add box 80 0 -0.55 12 0.3 24 0 texPath=GameData/Tex/Global/EFX/liquid_water.png texScaleU=1.5 texScaleV=1.5 flags=264320 surfAlpha=0.7 panU=0.05 panV=0.03

# --- Descent: 19 solid columns, 0.9 drop each, from the plateau edge to the floor ---

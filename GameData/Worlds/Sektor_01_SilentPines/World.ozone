# Zones: names must match the sibling .ozls entity names exactly.
# The scar's sky volume is nested inside the outer sky. UpdateSkyZone picks the
# smallest containing volume, so the interior wins while the player is inside
# and the outer sky takes over again at the tunnel mouth.
zone sky 92 -42 -8 140 42 40 1 name=silentpines_scar gravity=18 jump=9 terminal=60 water_gravity=8 water_drag=0.95 swim_up=5 ladder_speed=6 fly_mult=1.5
zone sky -112 -80 -12 160 80 52 1 name=silentpines_sky gravity=18 jump=9 terminal=60 water_gravity=8 water_drag=0.95 swim_up=5 ladder_speed=6 fly_mult=1.5
zone water 8 -70 -2 26 70 2 1 name=silentpines_river gravity=18 jump=9 terminal=60 water_gravity=7 water_drag=0.92 swim_up=4.5 ladder_speed=6 fly_mult=1.5
zone water 74 -12 -2 86 12 2 1 name=silentpines_pool gravity=18 jump=9 terminal=60 water_gravity=7 water_drag=0.92 swim_up=4.5 ladder_speed=6 fly_mult=1.5
zone reverb 59 29 0 75 45 9 1 name=silentpines_shrine gravity=18 jump=9 terminal=60 water_gravity=8 water_drag=0.95 swim_up=5 ladder_speed=6 fly_mult=1.5
# 3-axis gravity: `gravity=-18` is a straight-UP vector (engine +Y). The 0.3 s
# blend and the up basis do the camera roll; jump is along up, so the shaft is a
# vertical jump-and-run, not a scripted lift.
zone gravity 104 -32 0 118 -16 26 1 name=silentpines_choir gravity=-18 jump=9 terminal=14 water_gravity=8 water_drag=0.95 swim_up=5 ladder_speed=6 fly_mult=1.5
# CRT warp: any active volume of this type drives uWarpIntensity, even when it
# is not the primary zone (the interior sky volume usually wins that).
zone crt 116 -8 0 134 8 9 1 name=silentpines_crt gravity=18 jump=9 terminal=60 water_gravity=8 water_drag=0.95 swim_up=5 ladder_speed=6 fly_mult=1.5
# Ladder back down from the choir's ceiling gallery. It overlaps the entry
# corridor, not the reverse-gravity volume, so stepping off the ladder never
# re-triggers the upward pull.
zone ladder 118 -16 0 122 -12 26 1 name=silentpines_choir_ladder gravity=18 jump=9 terminal=60 water_gravity=8 water_drag=0.95 swim_up=5 ladder_speed=6 fly_mult=1.5

# Threshold at the bridge approach (off both playerstarts). Per-district def:
# the line belongs to THIS map (see Game/Angels95/Triggers/Trigger_S01_Bridge).
trigger Trigger_S01_Bridge -3 -9 0 -1 9 8 once
# Campaign exit behind the shrine. The arrival point is
# Sektor_02_MegacityGrid's authored playerstart (0 -34 0): entering a district
# must land on its gate, or the arrival skips the south-avenue read the map is
# built around. The bidir return portal is placed at that same point by the
# client, so it reads as the way back rather than a pad in the junction.
portal Sektor_02_MegacityGrid 75 38 0 79 42 6 0 -34 0 bidir

# --- Exit threshold (design/GAME_DESIGN.md §4: "the exit portal (shimmer)") ---
# Two co-located ambient emitters, warm gold to match the shrine's torches and
# deliberately unlike every combat effect. 26 + 6 live particles; both are
# untextured so they share the generated soft sprite (one batch). Gated by the
# Particles master toggle like every other OZONE emitter.
# Spec + budgets: design/vfx-sefirah1-exits.json.
ParticleEmitter mist 77 40 0.3 10 2.6 0.55 10 0.05 0.32 255 232 176 236 176 96 0.10 1.9 0 0 1 0
ParticleEmitter sparks 77 40 0.4 5 1.1 0.35 70 0.10 0.02 255 246 214 255 186 120 0.25 2.2 0 0 1 0
# The altar keeps a small light of its own, so the sword (the branch reward)
# reads from the bridge before the player commits to the shrine.
ParticleEmitter mist 67 37 2.2 6 2.2 0.35 8 0.04 0.22 255 226 160 255 190 110 -0.06 1.0 0 0 1 0

# Falls mist (direction is authored Z-up: 0 0 1 = up, negative gravity settles it)
ParticleEmitter mist 84 -4 0.2 18 2.5 1.8 22 0.2 1.8 230 235 240 190 200 215 -0.5 8 0 0 1 0
ParticleEmitter mist 84 4 0.2 18 2.5 1.8 22 0.2 1.8 230 235 240 190 200 215 -0.5 8 0 0 1 0
ParticleEmitter fire 60 30 1.4 26 0.8 2.6 10 0.35 0.05 255 175 70 255 60 0 -2 5 0 0 1 0
ParticleEmitter fire 74 30 1.4 26 0.8 2.6 10 0.35 0.05 255 175 70 255 60 0 -2 5 0 0 1 0
ParticleEmitter fire 60 44 1.4 26 0.8 2.6 10 0.35 0.05 255 175 70 255 60 0 -2 5 0 0 1 0
ParticleEmitter fire 74 44 1.4 26 0.8 2.6 10 0.35 0.05 255 175 70 255 60 0 -2 5 0 0 1 0
# The scar: falls mist at the mouth, cold dust in the choir, signal sparks in
# the control room and under the vault's ceiling eye.
ParticleEmitter mist 87 0 1 14 2.2 1.5 16 0.15 1.2 220 235 245 170 190 210 -0.4 6 0 0 1 0
ParticleEmitter smoke 111 -24 2 12 2.5 1.5 12 0.2 0.8 120 140 180 60 70 100 -0.6 5 0 0 1 0
ParticleEmitter sparks 118 0 1.8 8 0.8 0.3 48 0.05 0.02 120 240 255 80 180 255 0.3 3 0 0 1 0
ParticleEmitter sparks 107 36 7.5 4 0.5 0.2 30 0.04 0.02 180 120 255 120 80 255 0.1 2 0 0 1 0
ParticleEmitter sparks 107 31 0.6 6 0.7 0.25 40 0.03 0.01 120 220 255 80 160 255 0.1 1.6 0 0 1 0


// Refinery_Complex_02B - world sky zone (name=refinery_sky in World.ozone).
// The entity name must match the OZONE zone's name= exactly: zone enter/exit is
// dispatched on that key, and the registry re-points world defs on every load.
entity "refinery_sky" : skyzone {
    fog_color = (0.48, 0.42, 0.36)
    fog_density = 0.0055
    ambient_light = (0.44, 0.42, 0.40)
    skybox = "GameData/Tex/Global/Sky/sky_evening.png"
    actions {
        on_enter {
            set_fog 0.48 0.42 0.36 0.0055
            set_ambient 0.44 0.42 0.40
            set_skybox "GameData/Tex/Global/Sky/sky_evening.png"
            say "Refinery Complex 02B - the stack is still burning"
        }
        on_exit {
            restore_fog
            restore_skybox
            say "You leave the plant"
        }
    }
}

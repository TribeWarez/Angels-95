# World_endless_sky skyzone script.
# Heavy teal/cyan snow fog, cold ambient, overcast skybox.
entity "endless_snow_sky" : skyzone {
    fog_color = (0.45, 0.62, 0.68)
    fog_density = 0.007
    ambient_light = (0.42, 0.48, 0.52)
    skybox = "GameData/Tex/Global/Sky/sky_day.png"
    actions {
        on_enter {
            set_fog 0.45 0.62 0.68 0.007
            set_ambient 0.42 0.48 0.52
            set_skybox "GameData/Tex/Global/Sky/cloud02.png"
            say "World Endless Snow - radar contact lost, visibility zero"
        }
        on_exit {
            restore_fog
            restore_skybox
            say "Left the endless snow zone"
        }
    }
}

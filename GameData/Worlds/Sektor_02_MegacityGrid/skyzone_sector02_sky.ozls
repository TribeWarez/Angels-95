// Sektor_02_MegacityGrid - world sky zone (name=sector02_sky in World.ozone).
// The entity name must match the OZONE zone's name= exactly: zone enter/exit is
// dispatched on that key, and the registry re-points world defs on every load.
entity "sector02_sky" : skyzone {
    fog_color = (0.42, 0.34, 0.40)
    fog_density = 0.0045
    ambient_light = (0.42, 0.38, 0.44)
    skybox = "GameData/Tex/Global/Sky/sky_evening.png"
    actions {
        on_enter {
            set_fog 0.42 0.34 0.40 0.0045
            set_ambient 0.42 0.38 0.44
            set_skybox "GameData/Tex/Global/Sky/sky_evening.png"
            say "Megacity Grid - the relays are still warm"
        }
        on_exit {
            restore_fog
            restore_skybox
            say "You leave the grid behind"
        }
    }
}

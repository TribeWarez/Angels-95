# OZONE world – KryoArchipel_Severny (Hydrosis Prime / Dusk Falls)
# Dusk-lit cascade terraces: three levels stepping 16 -> 8 -> 0, two waterfalls,
# a ruined aqueduct over the upper fall, stepping stones through the basin and a
# lookout exit. Format: ozone v1.0
# Hierarchy: Hydrosis Prime -> Sefirah 2 -> KryoArchipel_Severny
#
# All-brush terrain: collision is AABB-only, so terraces are brushes. Every
# walkable rise is 0.9 or less (kStepHeight is exactly 1.0).
# Box arg order is  x y z  w h d  rot  where h is the VERTICAL size (Z).
#
# UV NOTE: BuildBox multiplies generated UVs by 16 (h >= 1.0) or 8 (thin), so an
# authored texScale is a MULTIPLIER on top. Keep values near 1 or the surfaces
# turn into moire noise.
#
# Zone names are the lookup keys for the sibling .ozls defs in this directory.

# --- Three terraces (y -90..78; the north strip y 78..90 carries the stairs) ---
add box -60 -6 7 60 18 168 0 texPath=GameData/Worlds/World_endless_snow/oztex/tileset/02_floor_snow_a3_32.png texScaleU=1 texScaleV=1
add box 0 -6 3 60 10 168 0 texPath=GameData/Worlds/World_endless_snow/oztex/tileset/04_floor_snow_a5_32.png texScaleU=1 texScaleV=1
add box 60 -6 -1 60 2 168 0 texPath=GameData/Worlds/World_endless_snow/oztex/tileset/03_floor_snow_a4_32.png texScaleU=1 texScaleV=1

# --- North strip: a floor at each terrace level so the stairs never open onto void ---
add box -60 84 7.5 60 17 12 0 texPath=GameData/Worlds/World_endless_snow/oztex/tileset/02_floor_snow_a3_32.png texScaleU=1 texScaleV=1
add box 0 84 3.5 60 9 12 0 texPath=GameData/Worlds/World_endless_snow/oztex/tileset/04_floor_snow_a5_32.png texScaleU=1 texScaleV=1
add box 60 84 -0.5 60 1 12 0 texPath=GameData/Worlds/World_endless_snow/oztex/tileset/03_floor_snow_a4_32.png texScaleU=1 texScaleV=1

# --- Stair run A: T1 (16) down to T2 (8), 0.9 risers, at y 84 ---

# Entities
playerstart -84 0 16 90
playerstart 70 0 0 0
pickup HealthVial -48 0 16.5 30
pickup ManaVial -16 0 8.4 30
pickup rifle_01 62 0 0.7 30
pickup Ammo 0 25 8.4 30
pickup Medkit 84 0 2.7 30
npc Skaarj -70 20 16
npc Walker -50 -25 16
npc Walker -85 0 16
npc Brute -20 25 8
npc Walker 0 -30 8
npc Skaarj 20 20 8
npc Floater 7 10 8
npc Walker 40 -20 0
npc Skaarj 55 20 0
npc Walker 70 -10 0

# --- Cascade sheets: 0.1 clear of the terrace face, scrolling downward ---
# flags = UNLIT 2048 | TRANSLUCENT 128 | TWO_SIDED 1024 | PAN_V 524288 | NO_BSP_CUTS 268435456
add box -29.9 0 12.15 0.2 8.3 20 0 texPath=GameData/Tex/Global/EFX/liquid_water.png texScaleU=1 texScaleV=1 flags=268962944 surfAlpha=0.6 panV=-0.35

light directional -40 -50 60 105 135 200 0.58
light point -24 -22 9.4 255 170 70 0.7 12 effect=2
light point -24 22 9.4 255 170 70 0.7 12 effect=2
light point 64 -16 1.4 255 170 70 0.7 12 effect=2
light point 64 16 1.4 255 170 70 0.7 12 effect=2

# Zones: names must match the sibling .ozls entity names exactly.
zone sky -93 -59 -6 93 59 50 1 name=duskfalls_sky gravity=18 jump=9 terminal=60 water_gravity=8 water_drag=0.95 swim_up=5 ladder_speed=6 fly_mult=1.5
zone water -54 -9 15 -34 9 18 1 name=duskfalls_upper gravity=18 jump=9 terminal=60 water_gravity=7 water_drag=0.92 swim_up=4.5 ladder_speed=6 fly_mult=1.5
zone water -29 -9 7 -3 9 10 1 name=duskfalls_middle gravity=18 jump=9 terminal=60 water_gravity=7 water_drag=0.92 swim_up=4.5 ladder_speed=6 fly_mult=1.5
zone water 31 -11 -1 57 11 3 1 name=duskfalls_basin gravity=18 jump=9 terminal=60 water_gravity=7 water_drag=0.92 swim_up=4.5 ladder_speed=6 fly_mult=1.5
zone reverb -27 -13 17 -21 13 22 1 name=duskfalls_aqueduct gravity=18 jump=9 terminal=60 water_gravity=8 water_drag=0.95 swim_up=5 ladder_speed=6 fly_mult=1.5

# Threshold at the upper cascade lip (off both playerstarts).
trigger Trigger_EnterVolume -34 -8 15 -32 8 18 once
# Campaign exit on the lookout. Spawn lands inside Refinery_Complex_02B's floor.
portal Refinery_Complex_02B 82 -4 2 86 4 7.5 0 0 1 bidir

# Cascade mist (authored direction is Z-up: 0 0 1 = up, negative gravity settles it)
ParticleEmitter mist -29 6 8.2 18 2.5 1.8 22 0.2 1.8 230 235 240 190 200 215 -0.5 8 0 0 1 0
ParticleEmitter mist -29 -6 8.2 18 2.5 1.8 22 0.2 1.8 230 235 240 190 200 215 -0.5 8 0 0 1 0

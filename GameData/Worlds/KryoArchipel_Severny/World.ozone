# NPC patrol loops (server-authoritative on --campaign).
PathNode t1_a -80 0 16.5 radius=4 next=t1_b
PathNode t1_b -40 0 16.5 radius=4 next=t1_c
PathNode t1_c -40 40 16.5 radius=4 next=t1_d
PathNode t1_d -80 40 16.5 radius=4 next=t1_a
PathNode t2_a -20 0 8.5 radius=4 next=t2_b
PathNode t2_b 20 0 8.5 radius=4 next=t2_c
PathNode t2_c 20 -40 8.5 radius=4 next=t2_d
PathNode t2_d -20 -40 8.5 radius=4 next=t2_a
PathNode t3_a 40 0 0.5 radius=4 next=t3_b
PathNode t3_b 60 0 0.5 radius=4 next=t3_c
PathNode t3_c 70 -30 0.5 radius=4 next=t3_d
PathNode t3_d 45 -30 0.5 radius=4 next=t3_a


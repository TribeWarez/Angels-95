add box 94 0 5 2 12 188 0 texPath=GameData/Tex/Tileset/Egypt/eg_mainstone_04.png texScaleU=1 texScaleV=2

# Entities
playerstart -84 0 16 90
playerstart 70 0 0 0
pickup HealthVial -50 0 16.5 30
pickup ManaVial 7 0 8.4 30
pickup rifle_01 45 0 1.5 30
pickup Ammo 0 30 8.4 30
pickup Medkit 84 0 2.7 30
npc Skaarj -70 20 16
npc Walker -50 -30 16
npc Walker -85 0 16
npc Brute -20 30 8
npc Walker 0 -40 8
npc Skaarj 20 20 8
npc Floater 7 10 8
npc Walker 40 -20 0
npc Skaarj 55 20 0
npc Walker 70 -10 0
light directional 80 30 25 205 190 215 0.72
light directional -40 -50 60 105 135 200 0.58
light point -24 -28 9.4 255 170 70 0.7 12 effect=2
light point -24 28 9.4 255 170 70 0.7 12 effect=2
light point 34 -12 1.4 255 170 70 0.7 12 effect=2
light point 34 12 1.4 255 170 70 0.7 12 effect=2

# Zones: names must match the sibling .ozls entity names exactly.
zone sky -93 -93 -6 93 93 50 1 name=duskfalls_sky gravity=18 jump=9 terminal=60 water_gravity=8 water_drag=0.95 swim_up=5 ladder_speed=6 fly_mult=1.5
zone water -58 -12 15 -31 12 18 1 name=duskfalls_upper gravity=18 jump=9 terminal=60 water_gravity=7 water_drag=0.92 swim_up=4.5 ladder_speed=6 fly_mult=1.5
zone water -14 -12 7 29 12 10 1 name=duskfalls_middle gravity=18 jump=9 terminal=60 water_gravity=7 water_drag=0.92 swim_up=4.5 ladder_speed=6 fly_mult=1.5
zone water 32 -14 -1 70 14 3 1 name=duskfalls_basin gravity=18 jump=9 terminal=60 water_gravity=7 water_drag=0.92 swim_up=4.5 ladder_speed=6 fly_mult=1.5
zone reverb -27 -26 17 -21 26 22 1 name=duskfalls_aqueduct gravity=18 jump=9 terminal=60 water_gravity=8 water_drag=0.95 swim_up=5 ladder_speed=6 fly_mult=1.5

# Threshold at the upper cascade lip (off both playerstarts).
trigger Trigger_EnterVolume -34 -8 15 -32 8 18 once
# Campaign exit on the lookout. Spawn lands inside Refinery_Complex_02B's floor.
portal Refinery_Complex_02B 82 -4 2 86 4 7.5 0 0 1 bidir

# Cascade mist (authored direction is Z-up: 0 0 1 = up, negative gravity settles it)
ParticleEmitter mist -29 6 8.2 18 2.5 1.8 22 0.2 1.8 230 235 240 190 200 215 -0.5 8 0 0 1 0
ParticleEmitter mist -29 -6 8.2 18 2.5 1.8 22 0.2 1.8 230 235 240 190 200 215 -0.5 8 0 0 1 0
ParticleEmitter mist 31 6 0.2 18 2.5 1.8 22 0.2 1.8 230 235 240 190 200 215 -0.5 8 0 0 1 0
ParticleEmitter mist 31 -6 0.2 18 2.5 1.8 22 0.2 1.8 230 235 240 190 200 215 -0.5 8 0 0 1 0
ParticleEmitter fire -24 -28 8.9 26 0.8 2.6 10 0.35 0.05 255 175 70 255 60 0 -2 5 0 0 1 0
ParticleEmitter fire -24 28 8.9 26 0.8 2.6 10 0.35 0.05 255 175 70 255 60 0 -2 5 0 0 1 0
ParticleEmitter fire 34 -12 0.9 26 0.8 2.6 10 0.35 0.05 255 175 70 255 60 0 -2 5 0 0 1 0
ParticleEmitter fire 34 12 0.9 26 0.8 2.6 10 0.35 0.05 255 175 70 255 60 0 -2 5 0 0 1 0
# Fireflies over the pools
ParticleEmitter fly -46 0 17.2 2 4 0.3 20 0.1 0.1 255 220 120 255 180 60 0.05 12 0 0 1 0
ParticleEmitter fly 7.8 0 9.2 2 4 0.3 20 0.1 0.1 255 220 120 255 180 60 0.05 12 0 0 1 0


# OZONE world scaffold - Phantom_Hubs
# Sector: Sefirah_4_CybrosisSubnet   (see Wiki/Game-Hierarchy.md)
# Placeholder geometry only: a floor, a perimeter and a sky zone.
# Format: ozone v1.0

levelinfo 0 8 5 0 10 50 0 GameData/Tex/Global/Sky/sky_darknight.png

# Floor (placeholder)
add box 0 0 -0.25 80 0.5 80 0
# Perimeter walls (placeholder)
add box 0 -40 1 80 2 2 0
add box 0 40 1 80 2 2 0
add box -40 0 1 2 2 80 0
add box 40 0 1 2 2 80 0

playerstart 0 0 0 0
light directional 50 50 80 200 205 215 0.3

zone sky -60 -60 -30 60 60 60 1 name=Phantom_Hubs_sky

# COOP content (scaffold): NPCs + pickups so objectives are completable.
npc Walker 10 10 0
npc Walker -10 10 0
npc Walker 10 -10 0
npc Walker -10 -10 0
npc Walker 0 20 0
pickup pistol_01 5 0 0
pickup rifle_01 -5 0 0
pickup etheral_waver 0 -5 0

# trigger scaffold
trigger Trigger_EnterVolume 8 -5 0 18 5 8 once
# portal scaffold to next mission world (box X 20-26, Y -4..4, Z 0-8; spawn 0 0 0 in the target)
portal SoulEater_Vaults 20 -4 0 26 4 8 0 0 0 bidir
// Phantom_Hubs - world sky zone (name=hubs_sky in World.ozone).
// The entity name must match the OZONE zone's name= exactly: zone enter/exit is
// dispatched on that key, and the registry re-points world defs on every load.
entity "hubs_sky" : skyzone {
    fog_color = (0.32, 0.34, 0.44)
    fog_density = 0.005
    ambient_light = (0.38, 0.40, 0.46)
    skybox = "GameData/Tex/Global/Sky/sky_darknight.png"
    actions {
        on_enter {
            set_fog 0.32 0.34 0.44 0.005
            set_ambient 0.38 0.40 0.46
            set_skybox "GameData/Tex/Global/Sky/sky_darknight.png"
            say "Phantom Hubs - no service is scheduled"
        }
        on_exit {
            restore_fog
            restore_skybox
            say "You leave the interchange"
        }
    }
}

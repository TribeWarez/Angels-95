OZONE
# CitadelRuins - a ruined hill-citadel: roofed courtyard, four corner towers,
# a gatehouse over the south gate, and watch balconies over a collar of sand.
# OZONE Z-up: x=east, y=north, z=up.
#
# Authoring notes:
#   * Ground level is z=0 across the whole map. The previous revision had the
#     outer sand topping out at z=-1.75 while the courtyard sat at z=0, a 1.75
#     rise - above the engine's kStepHeight of 1.0 - so the courtyard was a
#     one-way island you could leave but never re-enter.
#   * `box <cx> <cy> <cz> <w> <h> <d> <rot> [texSlot]` is CENTRE-based, h is the
#     Z extent, and texSlot is a BARE POSITIONAL after rot (NOT `texSlot=`).
#   * `cyl <cx> <cy> <cz> <rTop> <rBot> <h> <slices> <rot> [texSlot]` spans
#     z = [cz-h, cz]: the authored cz is the cylinder's TOP.
#   * Ceiling undersides sit at z=7.0 so a 3-tall player has ample clearance.
#   * Stair treads rise exactly 1.0 (kStepHeight) so they are walked, not jumped.
#   * Cover props top out at least 1.5 above their floor, otherwise the player
#     walks straight over them.
#   * Every zone carries an explicit, world-unique name=.
#   * `light directional <x> <y> <z>`: the point is the light SOURCE, aimed at
#     the world origin, so a large z is an overhead sun.

# ==============================================================================
# Ground. Plinth top = 0 (the courtyard deck), outer sand top = -1.0, so the
# step between them is exactly 1.0 in both directions.
# ==============================================================================
add box 0 0 -0.5 44 1 44 0 3          # citadel plinth, top z=0
add box 0 0 -1.25 84 0.5 84 0 1        # outer sand, top z=-1.0

# ==============================================================================
# Courtyard curtain walls (top z=7.0). 30x30 inner courtyard.
# South wall is in two segments leaving a 4-wide gate at x=-2..2.
# ==============================================================================
add box 0 15.25 3.5 30 7 0.5 0 2               # north
add box -8.5 -15.25 3.5 13 7 0.5 0 2           # south, west of the gate
add box 8.5 -15.25 3.5 13 7 0.5 0 2            # south, east of the gate
add box -15.25 0 3.5 0.5 7 30 0 2              # west
add box 15.25 0 3.5 0.5 7 30 0 2               # east

# ==============================================================================
# Corner towers (8x8 footprint, top z=14) - the citadel silhouette.
# ==============================================================================
add box -17 -17 7 8 14 8 0 3
add box 17 -17 7 8 14 8 0 3
add box -17 17 7 8 14 8 0 3
add box 17 17 7 8 14 8 0 3
# Crenellated lips
add box -17 -17 14.4 9 0.8 9 0 2
add box 17 -17 14.4 9 0.8 9 0 2
add box -17 17 14.4 9 0.8 9 0 2
add box 17 17 14.4 9 0.8 9 0 2
# Merlons on the tower lips
add box -19.5 -17 15.2 2 1 8 0 2
add box -14.5 -17 15.2 2 1 8 0 2
add box 19.5 -17 15.2 2 1 8 0 2
add box 14.5 -17 15.2 2 1 8 0 2
add box -19.5 17 15.2 2 1 8 0 2
add box -14.5 17 15.2 2 1 8 0 2
add box 19.5 17 15.2 2 1 8 0 2
add box 14.5 17 15.2 2 1 8 0 2

# ==============================================================================
# Gatehouse over the south gate (x -4..4, y=-15.25).
# ==============================================================================
add box -3 -15.25 3.5 2 7 2 0 3            # gate jamb, west
add box 3 -15.25 3.5 2 7 2 0 3             # gate jamb, east
add box 0 -15.25 8.5 10 3 3 0 3            # lintel / gatehouse block
add box 0 -15.25 10.4 8 0.8 3 0 2          # cap
add box -2.5 -15.25 10.4 2 1.6 3 0 2        # merlons
add box 0 -15.25 10.4 2 1.6 3 0 2           # merlon
add box 2.5 -15.25 10.4 2 1.6 3 0 2        # merlon

# ==============================================================================
# Merlons along the curtain walls, so the skyline is not four flat lines.
# ==============================================================================
add box -12 15.25 7.4 2 0.8 0.5 0 2
add box -8 15.25 7.4 2 0.8 0.5 0 2
add box -4 15.25 7.4 2 0.8 0.5 0 2
add box 4 15.25 7.4 2 0.8 0.5 0 2
add box 8 15.25 7.4 2 0.8 0.5 0 2
add box 12 15.25 7.4 2 0.8 0.5 0 2
add box -15.25 -10 7.4 0.5 0.8 2 0 2
add box -15.25 -6 7.4 0.5 0.8 2 0 2
add box -15.25 6 7.4 0.5 0.8 2 0 2
add box -15.25 10 7.4 0.5 0.8 2 0 2
add box 15.25 -10 7.4 0.5 0.8 2 0 2
add box 15.25 -6 7.4 0.5 0.8 2 0 2
add box 15.25 6 7.4 0.5 0.8 2 0 2
add box 15.25 10 7.4 0.5 0.8 2 0 2

# ==============================================================================
# Courtyard roof in 04_ceiling_sky_128 (a bright gold "sky" panel), leaving a
# central oculus so a shaft of daylight drops onto the centrepiece, and stopping
# at x=+-10 so the watch galleries along the curtain walls stay open to the sky.
# Underside z=7.0.
# ==============================================================================
add box -6.5 0 7.3 7 0.6 30 0 4
add box 6.5 0 7.3 7 0.6 30 0 4
add box 0 -10 7.3 10 0.6 10 0 4
add box 0 10 7.3 10 0.6 10 0 4

# ==============================================================================
# Courtyard floor detail + centrepiece. The centrepiece top is z=1.5, above
# kStepHeight, so it is real cover (the old one was only 1.5 tall from z=-0.25
# and read as a kerb).
# ==============================================================================
add box 0 0 0.75 4 1.5 4 0 3                # centre plinth, top z=1.5
add cyl 0 0 3.5 0.7 0.7 2 16 0 3            # finial, spans z 1.5..3.5
# Inlaid paving rings, 0.2 proud so they read without being an obstacle
add box 0 0 0.1 20 0.2 20 0 1
add box 0 0 0.22 10 0.2 10 0 2

# ==============================================================================
# Watch galleries on the east and west curtain walls (top z=5.8). They sit outside
# the roofed band, which stops at x=+-10, so they stay open to the sky, and their
# 5.3 underside clears the 5.25 a full jump needs.
# ==============================================================================
add box -13 10 5.55 6 0.5 8 0 3              # west gallery, x -16..-10, y 6..14
add box 13 10 5.55 6 0.5 8 0 3               # east gallery, x 10..16, y 6..14
add box -16 10 6.7 0.5 1.8 8 0 3             # west parapet, top z=7.6
add box 16 10 6.7 0.5 1.8 8 0 3              # east parapet, top z=7.6
# Balcony corbels
add box -15 6.5 5.3 1.5 1 1.5 0 3
add box -15 13.5 5.3 1.5 1 1.5 0 3
add box 15 6.5 5.3 1.5 1 1.5 0 3
add box 15 13.5 5.3 1.5 1 1.5 0 3

# ==============================================================================
# Stair runs up to the galleries. Five treads of exactly 1.0, on the courtyard
# face of each gallery and clear of it, so the walkway is reached with a step.
# Tread k: top z=k, so centre y = 0.5+k, centre z=k/2, height=k.
# ==============================================================================
add box -13 1.5 0.5 4 1 1 0 1
add box -13 2.5 1 4 2 1 0 1
add box -13 3.5 1.5 4 3 1 0 1
add box -13 4.5 2 4 4 1 0 1
add box -13 5.5 2.5 4 5 1 0 1
add box 13 1.5 0.5 4 1 1 0 1
add box 13 2.5 1 4 2 1 0 1
add box 13 3.5 1.5 4 3 1 0 1
add box 13 4.5 2 4 4 1 0 1
add box 13 5.5 2.5 4 5 1 0 1

# ==============================================================================
# Cover inside the courtyard. All tops are >=1.5 above the floor so they block.
# ==============================================================================
add box -8 -6 0.75 5 1.5 3 0 2
add box 8 6 0.75 5 1.5 3 0 2
add box -8 7 0.75 3 1.5 3 0 2
add box 7 -7 0.75 3 1.5 3 0 2
# Rubble against the towers (the east pile carries the gallery above it)
add cyl -12 -12 1.8 1.5 1.5 1.8 16 0 3
add cyl 12 12 5.3 1.8 1.8 5.3 16 0 3

# ==============================================================================
# South corridor: a covered approach running south from the gate.
# Deck top z=0, walls 5.3 tall, ceiling underside z=5.3 (a full jump needs 5.25).
# ==============================================================================
add box 0 -27 -0.5 4.5 1 26 0 1              # corridor deck (top z=0)
add box -2.75 -27 2.65 0.5 5.3 26 0 2          # west wall
add box 2.75 -27 2.65 0.5 5.3 26 0 2           # east wall
add box 0 -27 5.6 6 0.6 26 0 4                # ceiling, underside z=5.3
add box 0 -39.75 2.65 5 5.3 0.5 0 2            # south end wall
# Approach ramp out of the corridor onto the sand (two 1.0 steps down)
add box 0 -41.5 -1 4.5 1 3 0 1
add box 0 -43.5 -1.25 4.5 0.5 1 0 1

# ==============================================================================
# Painted cliff backdrop (SURF_FAKEBACKDROP, flags=8). Unlit at full painted
# value and the map's outer collision edge. Heights alternate so the skyline
# is broken.
#
# texScale is 1x1 on purpose. At 3x2 a 256x256 source tiled across a 60-unit
# panel works out to ~12 texels per world unit - far too crisp for something
# 42 units away, so it read as a stone wall standing next to the arena instead
# of a cliff receding past it, and the 3x2 repeat grid made that worse on every
# panel. At 1x1 the whole image covers the face once: no internal repeat, and the
# texel density drops to ~4/unit, which is soft enough to sit back. Per-panel
# offsets are deliberately NOT used - at scale 1 an offset would run the UVs past
# 1.0 and seam across the middle of the panel.
#
# These boxes are also the arena's collision boundary (flags=8 does not imply
# SURF_NO_BSP_CUTS, which is 1<<28), so their positions and extents are gameplay
# and must not be changed for purely visual reasons. Texture and UVs only.
#
# The texScale kwargs are written out even though 1.0 is the default, to record
# that the tiling was a deliberate choice. ExportToOzone omits them when they
# equal 1.0, so saving from AngelEd will strip both kwargs off all 12 lines and
# leave a larger-than-necessary diff - the render is identical either way, because
# uvScaleU/uvScaleV default to 1.0 (SurfaceFlags.hpp).
# ==============================================================================
add box -30 42 11 30 22 1 0 flags=8 texPath=oztex/bb_wall_13.png texScaleU=1 texScaleV=1
add box 0 42 13 30 26 1 0 flags=8 texPath=oztex/bb_wall_13.png texScaleU=1 texScaleV=1
add box 30 42 9 30 18 1 0 flags=8 texPath=oztex/bb_wall_13.png texScaleU=1 texScaleV=1
add box -30 -42 9 30 18 1 0 flags=8 texPath=oztex/bb_wall_13.png texScaleU=1 texScaleV=1
add box 0 -42 12 30 24 1 0 flags=8 texPath=oztex/bb_wall_13.png texScaleU=1 texScaleV=1
add box 30 -42 13 30 26 1 0 flags=8 texPath=oztex/bb_wall_13.png texScaleU=1 texScaleV=1
add box 42 -30 11 1 22 30 0 flags=8 texPath=oztex/bb_wall_13.png texScaleU=1 texScaleV=1
add box 42 0 12 1 24 30 0 flags=8 texPath=oztex/bb_wall_13.png texScaleU=1 texScaleV=1
add box 42 30 10 1 20 30 0 flags=8 texPath=oztex/bb_wall_13.png texScaleU=1 texScaleV=1
add box -42 -30 12 1 24 30 0 flags=8 texPath=oztex/bb_wall_13.png texScaleU=1 texScaleV=1
add box -42 0 10 1 20 30 0 flags=8 texPath=oztex/bb_wall_13.png texScaleU=1 texScaleV=1
add box -42 30 11 1 22 30 0 flags=8 texPath=oztex/bb_wall_13.png texScaleU=1 texScaleV=1

# ==============================================================================
# Entities
# ==============================================================================
# Only playerstart #1 is ever used, so this line decides the first frame. Just
# inside the south gate looking north up the courtyard: the centre plinth under
# the oculus dead ahead, the east and west balconies flanking, towers at the
# corners and the gatehouse lintel behind. The previous spawn faced a wall 2.25
# away from inside the courtyard.
playerstart 0 -11 0 180
playerstart 0 -34 0 180

# --- Pickups (all on a real surface, none inside a brush) ---
pickup HealthVial 0 -13 1 25            # gate threshold
pickup Medkit 0 0 1.5 45                # on the centre plinth
pickup Medkit 0 -27 1 30                # south corridor
pickup Coin -11 -20 -0.5 30             # on the sand outside the gate
pickup HealthVial 11 -20 -0.5 30        # on the sand outside the gate
pickup rifle_01 -13 8 6.3 20              # west gallery
pickup pistol_01 13 8 6.3 30              # east gallery
pickup ManaVial -8 7 1.8 30             # on the courtyard cover
pickup EnergyCrystal 8 -6 1.8 30        # on the courtyard cover
pickup Key 0 -33 1 30                   # deep in the corridor

# ==============================================================================
# NPC patrol graphs. Links are by NAME so the graph survives editor reordering.
# ==============================================================================
PathNode court_sw -9 -9 1 radius=3 next=court_se,court_nw
PathNode court_se 8 -7 1 radius=3 next=court_ne,court_sw
PathNode court_ne 9 7 1 radius=3 next=court_nw,court_se
PathNode court_nw -8 7 1 radius=3 next=court_sw,court_ne
PathNode centre 0 0 1 radius=2.5 next=court_sw
PathNode gate 0 -13 1 radius=2.5 next=corridor
PathNode corridor 0 -27 1 radius=2.5 next=gate,court_s
PathNode court_s 0 -6 1 radius=2.5 next=corridor,court_sw
PathNode balk_w -13 8 4.5 radius=2 next=balk_e
PathNode balk_e 13 8 4.5 radius=2 next=balk_w
PathNode sand_n -11 -20 -0.5 radius=4 next=sand_s
PathNode sand_s 11 -20 -0.5 radius=4 next=sand_n

npc Skaarj -8 -7 1
npc Skaarj 8 6 1
npc Brute 0 -13 1
npc Walker -13 8 4.5
npc Walker 13 8 4.5
npc Skaarj 0 -30 1
npc Brute -11 -20 -0.5

# ==============================================================================
# Lights. effect 2 = TORCH, 1 = WATERY, 3 = FIRE, 4 = LAMP.
# ==============================================================================
# Low evening sun raking from the west; weak opposing fill for the shadows.
light directional -70 -40 70 255 225 180 0.85
light directional 60 50 40 150 165 195 0.25

# Courtyard: daylight through the oculus plus warm braziers on the towers
light point 0 0 6 255 240 210 0.7 22
light point -17 -17 11 255 180 90 0.6 16 2
light point 17 -17 11 255 180 90 0.6 16 2
light point -17 17 11 255 180 90 0.6 16 2
light point 17 17 11 255 180 90 0.6 16 2
# Gate lanterns
light point -3 -15 4 255 190 120 0.5 10 2
light point 3 -15 4 255 190 120 0.5 10 2
# Balcony lamps
light point -13 8 6.5 255 205 150 0.45 12
light point 13 8 6.5 255 205 150 0.45 12
# Corridor
light point 0 -22 4 255 205 150 0.45 14
light point 0 -33 4 255 205 150 0.45 14
# Sand outside the gate
light point -11 -22 -0.5 255 200 150 0.4 16
light point 11 -22 -0.5 255 200 150 0.4 16

# ==============================================================================
# Zones
# ==============================================================================
# Named explicitly: auto-generated names ("zone_sky_0") collide between worlds
# and made this map run another world's skyzone script. The gravity/jump kwargs
# were also dropped - they pinned gravity=20/jump=8 while the engine is now
# gravity 18 / jump 9, so they were silently overriding the new tuning.
zone sky -100 -100 -30 100 100 90 1 name=citadel_sky
# Courtyard reverb - a roofed stone box
zone reverb -14 -14 0 14 14 7 name=citadel_court
# Sand heat-haze outside the gate
zone sound -20 -40 -1 20 -16 1 name=citadel_approach

# Evening sky, matching skyzone_citadel.ozls (which previously disagreed with
# levelinfo, so the authored dusk sky was overridden by a night one).
levelinfo 0 8 5 0 10 50 0 GameData/Global/sky/sky_evening.png GameData/Global/sky/sky_death_land.png
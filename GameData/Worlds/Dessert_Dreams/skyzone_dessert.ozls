entity "dd_sky" : skyzone {
    fog_color = (0.86, 0.80, 0.68)
    fog_density = 0.004
    ambient_light = (0.72, 0.70, 0.66)
    skybox = "GameData/Global/sky/sky_noon.png"
    actions {
        on_enter {
            set_fog 0.86 0.80 0.68 0.004
            set_ambient 0.72 0.70 0.66
            set_skybox "GameData/Global/sky/sky_noon.png"
            say "Desert Dreams - the oasis is held, something moves in the outpost"
        }
        on_exit {
            restore_fog
            restore_skybox
            say "Left the Desert Dreams sky zone"
        }
    }
}

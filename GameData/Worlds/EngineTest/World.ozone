zone water -4.5 -14.5 -0.2 4.5 -5.5 3.5 name=engine_water
zone ladder 70.4 20 0 71.6 24 11 name=arena_ladder
zone reverb 8.5 -49.5 0 31.5 -26.5 8 name=engine_reverb
zone sound 12.5 2.5 0 27.5 17.5 8 name=engine_sound


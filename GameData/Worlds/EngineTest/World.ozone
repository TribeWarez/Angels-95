OZONE
# EngineTest - validation facility: five chambers, a great hall and a courtyard,
# plus one zone of every zone type and a portal to Dust_Ravine.
# OZONE Z-up: x=east, y=north, z=up.
#
# Authoring notes:
#   * Every floor top sits at exactly z=0. Room floors are INLAYS at
#     z 0.05..0.45 sitting on the base slab rather than overlapping it. The
#     previous revision had the 60x85 ground at z -0.75..-0.25 interpenetrating
#     all five room floors at z -0.5..0 (and the grass slab fighting the ground
#     across an 8.5u band), which z-fought visibly on every floor.
#   * Walls are h=4 with ceilings at underside z=4.0. They used to be h=10 -
#     3.3x the player height - so every chamber read as a shaft open to the sky.
#   * `texSlot` is a BARE POSITIONAL after rot, not `texSlot=`.
#   * `cyl <cx> <cy> <cz> <rTop> <rBot> <h> <slices> <rot>` spans z=[cz-h, cz].
#   * Cover tops are >=1.5 above their floor so they still block.
#   * Every zone carries an explicit, world-unique name=.

# ==============================================================================
# Base slab (top z=0), y -50..45; grass slab butted against it at y=-50.
# They share the edge instead of overlapping.
# ==============================================================================
add box 10 -2.5 -0.25 60 0.5 95 0 1        # facility slab
add box 20 -71 -0.25 46 0.5 42 0 5        # outdoor grass, butts at y=-50

# ==============================================================================
# Chamber floors as inlays, 0.4 proud and clear of the slab top.
# ==============================================================================
add box 0 10 0.25 15 0.4 15 0 1           # Room 1
add box 20 10 0.25 15 0.4 15 0 1          # Room 2
add box 20 -10 0.25 15 0.4 15 0 1         # Room 3
add box 0 -10 0.25 15 0.4 15 0 1          # Room 4
add box 20 -38 0.25 23 0.4 23 0 1         # Great Hall

# ==============================================================================
# ROOM 1 (NW) - lobby. North wall is split to carve the Dust_Ravine portal.
# ==============================================================================
add box -5.25 17.75 2 4.5 4 0.5 0 2       # north wall, west of the portal gap
add box 5.25 17.75 2 4.5 4 0.5 0 2        # north wall, east of the gap
add box 0 17.75 3.75 6 0.5 0.5 0 2        # portal lintel
add box -5 2.25 2 5 4 0.5 0 2              # south wall, west
add box 5 2.25 2 5 4 0.5 0 2               # south wall, east
add box 7.75 15 2 0.5 4 5 0 2             # east wall, upper
add box 7.75 5 2 0.5 4 5 0 2              # east wall, lower
add box -7.75 10 2 0.5 4 15 0 2           # west wall
add box 0 10 4.25 15 0.5 15 0 4           # ceiling
add cyl 0 10 4 0.8 0.8 4 16 0 3          # support column, spans z 0..4
add cyl 0 10 4.4 1.1 1.1 0.8 16 0 3      # capital

# ==============================================================================
# ROOM 2 (NE)
# ==============================================================================
add box 20 17.75 2 15 4 0.5 0 2
add box 15 2.25 2 5 4 0.5 0 2
add box 25 2.25 2 5 4 0.5 0 2
add box 27.75 10 2 0.5 4 15 0 2
add box 12.25 15 2 0.5 4 5 0 2
add box 12.25 5 2 0.5 4 5 0 2
add box 20 10 4.25 15 0.5 15 0 4
add cyl 20 10 4 0.8 0.8 4 16 0 3
add cyl 20 10 4.4 1.1 1.1 0.8 16 0 3

# ==============================================================================
# ROOM 3 (SW hub)
# ==============================================================================
add box 15 -2.75 2 5 4 0.5 0 2
add box 25 -2.75 2 5 4 0.5 0 2
add box 15 -17.75 2 5 4 0.5 0 2
add box 25 -17.75 2 5 4 0.5 0 2
add box 27.75 -10 2 0.5 4 15 0 2
add box 12.25 -5 2 0.5 4 5 0 2
add box 12.25 -15 2 0.5 4 5 0 2
add box 20 -10 4.25 15 0.5 15 0 4
add cyl 20 -10 4 0.8 0.8 4 16 0 3
add cyl 20 -10 4.4 1.1 1.1 0.8 16 0 3

# ==============================================================================
# ROOM 4 (SE) - flooded test chamber
# ==============================================================================
add box -5 -2.75 2 5 4 0.5 0 2
add box 5 -2.75 2 5 4 0.5 0 2
add box 0 -17.75 2 15 4 0.5 0 2
add box 7.75 -5 2 0.5 4 5 0 2
add box 7.75 -15 2 0.5 4 5 0 2
add box -7.75 -10 2 0.5 4 15 0 2
add box 0 -10 4.25 15 0.5 15 0 4
add cyl 0 -10 4 0.8 0.8 4 16 0 3
add cyl 0 -10 4.4 1.1 1.1 0.8 16 0 3
# Sump the water zone sits in: a shallow recessed pan so the flood reads
add box 0 -10 0.05 9 0.5 9 0 2

# ==============================================================================
# GREAT HALL - with a ceiling atrium over a raised dais.
# ==============================================================================
add box 13 -26.75 2 9 4 0.5 0 2
add box 27 -26.75 2 9 4 0.5 0 2
add box 12 -49.75 2 9 4 0.5 0 2           # south wall west, gap x 16.5..23.5
add box 28 -49.75 2 9 4 0.5 0 2           # south wall east
add box 0 -49.75 3.75 7 0.5 0.5 0 2       # exit lintel
add box 31.75 -38 2 0.5 4 23 0 2
add box 8.25 -38 2 0.5 4 23 0 2
# Atrium dais under the ceiling gap, reached by a 1.0 step
add box 20 -38 0.75 11 1.5 11 0 2         # dais, top z=1.5
add box 20 -32 0.5 11 1 1 0 1              # step up to the dais
add cyl 20 -38 3.5 0.9 0.9 2 16 0 3       # dais finial, spans 1.5..3.5
# Ceiling in two slabs, leaving a 9x9 atrium over the dais
add box 13.75 -38 4.25 7.5 0.5 23 0 4
add box 26.25 -38 4.25 7.5 0.5 23 0 4
# Colonnade
add cyl 12 -30 4 0.8 0.8 4 16 0 3
add cyl 28 -30 4 0.8 0.8 4 16 0 3
add cyl 12 -46 4 0.8 0.8 4 16 0 3
add cyl 28 -46 4 0.8 0.8 4 16 0 3

# ==============================================================================
# Corridors A-E, all roofed at 4.0.
# ==============================================================================
add box 10 12.75 2 5 4 0.5 0 2
add box 10 7.25 2 5 4 0.5 0 2
add box 10 10 4.25 5 0.5 5 0 4

add box 22.75 0 2 0.5 4 5 0 2
add box 17.25 0 2 0.5 4 5 0 2
add box 20 0 4.25 5 0.5 5 0 4

add box 10 -7.25 2 5 4 0.5 0 2
add box 10 -12.75 2 5 4 0.5 0 2
add box 10 -10 4.25 5 0.5 5 0 4

add box 2.75 0 2 0.5 4 5 0 2
add box -2.75 0 2 0.5 4 5 0 2
add box 0 0 4.25 5 0.5 5 0 4

add box 22.75 -22 2 0.5 4 9 0 2
add box 17.25 -22 2 0.5 4 9 0 2
add box 20 -22 4.25 5 0.5 9 0 4

# ==============================================================================
# OUTDOOR COURTYARD (south of the Great Hall)
# ==============================================================================
add box 20 -49.75 0.25 12 0.4 1 0 1      # threshold inlay
add box 20 -55 0.25 6 0.4 10 0 1         # walkway inlay
# Compound walls raised to 3.5 so they actually enclose a 3-tall player and
# block. At h=1 they sat exactly at kStepHeight and were walked over; at h=2
# they still read as curbs with the sky visible straight over them.
add box 12 -62 1.75 12 3.5 18 0 2
add box 28 -62 1.75 12 3.5 18 0 2
add box 12 -75 1.75 12 3.5 8 0 2
add box 28 -75 1.75 12 3.5 8 0 2
add box 20 -78.5 1.75 12 3.5 1 0 2         # far wall
add box 4 -62 1.75 4 3.5 26 0 2            # west side wall
add box 36 -62 1.75 4 3.5 26 0 2           # east side wall
# Courtyard paving inlay so the concrete/grass seam is deliberate
add box 20 -66 0.25 28 0.4 24 0 1
# Walkway walls + pergola roof over the rear half
add box 16 -55 2 2 4 7 0 2
add box 24 -55 2 2 4 7 0 2
add box 20 -52 4.25 8 0.5 4 0 4
# Tall courtyard pillars
add cyl 12 -55 6 0.5 0.5 6 16 0 3
add cyl 28 -55 6 0.5 0.5 6 16 0 3
add cyl 12 -72 6 0.5 0.5 6 16 0 3
add cyl 28 -72 6 0.5 0.5 6 16 0 3
# Planters / benches
add box 20 -66 0.9 6 1.8 2 0 3
add box 20 -70 0.9 6 1.8 2 0 3

# ==============================================================================
# Interior cover: crates and terminals (tops >=1.5), and wall panelling.
# ==============================================================================
add box -4 6 0.9 2 1.8 2 0 3
add box 4 13 1.25 2 2.5 2 0 3
add box 24 6 0.9 2 1.8 2 0 3
add box 16 13 1.25 2 2.5 2 0 3
add box 24 -14 0.9 2 1.8 2 0 3
add box 16 -6 1.25 2 2.5 2 0 3
add box -4 -6 0.9 2 1.8 2 0 3
add box -4 -14 1.25 2 2.5 2 0 3
add box 14 -42 0.9 2 1.8 2 0 3
add box 26 -34 0.9 2 1.8 2 0 3
add box 26 -44 1.25 2 2.5 2 0 3
# Service panelling along the Great Hall walls
add box 9.5 -38 1.5 1 3 20 0 3
add box 30.5 -38 1.5 1 3 20 0 3

# ==============================================================================
# Painted tech backdrop (SURF_FAKEBACKDROP, flags=8) - the facility's outer
# shell and the courtyard's collision edge.
# ==============================================================================
add box 0 45 8 60 16 1 0 flags=8 texPath=oztex/tileset/04_ceiling_tech_128.png texScaleU=4 texScaleV=2
add box 40 0 8 1 16 60 0 flags=8 texPath=oztex/tileset/04_ceiling_tech_128.png texScaleU=4 texScaleV=2
add box -40 0 8 1 16 60 0 flags=8 texPath=oztex/tileset/04_ceiling_tech_128.png texScaleU=4 texScaleV=2
add box 0 -92 9 60 18 1 0 flags=8 texPath=oztex/tileset/04_ceiling_tech_128.png texScaleU=5 texScaleV=2
add box 43 -70 8 1 16 44 0 flags=8 texPath=oztex/tileset/04_ceiling_tech_128.png texScaleU=5 texScaleV=2
add box -43 -70 8 1 16 44 0 flags=8 texPath=oztex/tileset/04_ceiling_tech_128.png texScaleU=5 texScaleV=2

# ==============================================================================
# Entities
# ==============================================================================
playerstart 0 8 0 0
playerstart 0 -66 0 0

# Portal to Dust_Ravine, sized to the opening carved in Room 1's north wall
# (x -3..3, 3 tall under a lintel). Spawn is in Dust_Ravine coords.
portal Dust_Ravine -3 15 0 3 19 3.5 -66 8 2 bidir

# --- Pickups, one per chamber, each with a matching light colour ---
pickup HealthVial 0 10 0.7          # Room 1 - red
pickup ManaVial 20 10 0.7           # Room 2 - blue
pickup Key 20 -10 0.7               # Room 3 - orange
pickup Coin 0 -10 0.7               # Room 4 - yellow
pickup EnergyCrystal 20 -38 2.0     # Great Hall dais
pickup Powerup 28 -38 0.7
pickup HealthVial 0 -30 0.7         # Corridor E
pickup ManaVial 12 -70 0.7          # Courtyard
pickup Medkit 12 -38 2.0            # Great Hall west aisle - 3D medkit mesh
pickup Ammo 28 -30 0.7              # Corridor E - ammunition box (PickupType::AMMO)

# ==============================================================================
# NPC patrol graphs (links by NAME).
# ==============================================================================
PathNode r1_a -4 5 1 radius=3 next=r1_b
PathNode r1_b 4 14 1 radius=3 next=r1_a
PathNode r2_a 24 5 1 radius=3 next=r2_b
PathNode r2_b 16 14 1 radius=3 next=r2_a
PathNode r3_a 24 -14 1 radius=3 next=r3_b
PathNode r3_b 16 -5 1 radius=3 next=r3_a
PathNode r4_a -4 -6 1 radius=3 next=r4_b
PathNode r4_b -4 -15 1 radius=3 next=r4_a
PathNode hall_a 14 -42 0.5 radius=4 next=hall_b
PathNode hall_b 26 -34 0.5 radius=4 next=hall_c
PathNode hall_c 26 -44 0.5 radius=4 next=hall_d
PathNode hall_d 14 -34 0.5 radius=4 next=hall_a
PathNode court 20 -66 0.5 radius=5 next=hall_a

npc Walker -4 5 1
npc Skaarj 24 5 1
npc Brute 24 -14 1
npc Walker -4 -6 1
npc Floater 14 -42 0.5
npc Walker 26 -44 0.5
npc Skaarj 20 -66 0.5

# ==============================================================================
# Lights. effect 2 = TORCH, 1 = WATERY, 3 = FIRE, 4 = LAMP.
# ==============================================================================
# Overcast daylight. This light previously did nothing at all: the loader left
# a directional light's position at the origin, so lightDir pointed downward and
# every up-facing surface got NdotL = 0.
light directional -50 -50 70 205 215 235 0.30
light directional 50 50 40 140 155 180 0.12

# Chamber lights, colour-coded to the pickups
light point 0 10 3 255 60 60 0.45 22
light point 20 10 3 80 130 255 0.45 22
light point 20 -10 3 255 170 50 0.45 22
light point 0 -10 3 255 220 60 0.45 22
# Great Hall: cool strips under the ceiling slabs + a warm dais lamp
light point 12 -30 3.5 200 215 255 0.38 20
light point 28 -44 3.5 200 215 255 0.38 20
light point 20 -38 3 255 225 190 0.45 16
# Corridors
light point 20 -22 3 190 205 255 0.45 16
light point 10 0 3 190 205 255 0.4 14
# Courtyard braziers (TORCH, not WATERY)
light point 12 -55 3 255 180 80 0.6 18 2
light point 28 -55 3 255 180 80 0.6 18 2
light point 12 -72 3 255 180 80 0.5 16
light point 28 -72 3 255 180 80 0.5 16
light point 20 -66 2 120 200 255 0.4 22

# ==============================================================================
# Zones - named explicitly and sized to their actual chambers (z 0..4).
# The reverb zone previously covered only ~35% of the Great Hall.
# ==============================================================================
zone sky -80 -80 -30 80 80 90 1 name=engine_sky
zone water -4.5 -14.5 -0.2 4.5 -5.5 3.5 name=engine_water
zone ladder -2.5 -2.5 0 2.5 2.5 4 name=engine_ladder
zone reverb 8.5 -49.5 0 31.5 -26.5 4 name=engine_reverb
zone sound 12.5 2.5 0 27.5 17.5 4 name=engine_sound

# gameType is numeric; the old SINGLEPLAYER token only parsed because std::stof
# threw and the parser substituted 0.
levelinfo 0 8 5 0 10 50 0 GameData/Global/sky/sky_day.png GameData/Global/sky/sky_noon.png
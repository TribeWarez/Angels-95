# Entities
# ==============================================================================
playerstart 0 8 0 0
playerstart 0 -66 0 0

# Portal to Dust_Ravine, sized to the opening in Room 1's north wall
# (x -3..3, 5.5 tall under its surround). Spawn is in Dust_Ravine coords.
portal Dust_Ravine -3 15 0 3 19 5.5 -66 8 2 bidir

# --- Pickups ---
pickup HealthVial 0 10 0.7          # Room 1 - red
pickup ManaVial 20 10 0.7           # Room 2 - blue
pickup Key 20 -10 0.7               # Room 3 - orange
pickup Coin 0 -10 0.7               # Room 4 - yellow
pickup EnergyCrystal 20 -38 2.0     # Great Hall dais
pickup Powerup 28 -38 0.7
pickup HealthVial 0 -30 0.7         # Corridor E
pickup ManaVial 12 -70 0.7          # Courtyard
pickup Medkit 12 -38 2.0            # Great Hall west aisle - 3D medkit mesh
pickup Ammo 28 -30 0.7              # Corridor E - ammunition box
# Arena: the weapons the pyramid court is meant to be fought with
pickup rifle_01 59 -14 0.7
pickup etheral_waver 59 14 0.7
pickup HealthVial 44 -8 0.7
pickup Ammo 44 6 0.7
pickup Powerup 74 22 9.5            # watchtower reward - ladder only


OZONE
# EngineTest - the facility's validation and showcase level: five chambers, a
# great hall, a courtyard, and an eastern ARENA with a stepped pyramid, a
# watchtower and a brazier court.
# OZONE Z-up: x=east, y=north, z=up.
#
# =-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=
# CLEARANCE RULE - read this before changing any ceiling or wall height.
#
# The player is Height=3.0 with the box anchored to the FEET, and a jump from
# rest rises jumpSpeed^2 / (2*gravity) = 9^2 / 36 = 2.25. So the collision box
# reaches feet + 3.0 + 2.25 = feet + 5.25 at the top of a jump.
#
# A ceiling lower than that is not decoration, it is a TRAP: jumping slams the
# box into it and OverlapsObstacle rolls the ENTIRE move back, so the player
# appears to stick to the wall they jumped next to. The previous revision had
# every interior ceiling at 4.0 - a 1.0 clearance - which is exactly that bug.
#
# The highest surface the player can stand on is what decides it: a surface is
# reachable by a 1.0 step (kStepHeight) or a 2.25 jump, and the tallest prop here
# tops out at 2.5. So a ceiling must be at least 2.5 + 5.25 = 7.75. Every
# interior ceiling in this world is at 8.0 (walls h=8, ceiling slab centred
# 8.25), and doorway openings are 5.5 tall for the same reason: a lintel below
# 5.25 jams a jump in the doorway.
#
# The arena and courtyard are open to the sky, which is why their tall props
# (the 6-tall pyramid steps, the 12-tall obelisk) are safe there and would not
# be indoors.
# =-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=
#
# Other authoring notes:
#   * Every floor top sits at exactly z=0. Room floors are INLAYS at z 0.05..0.45
#     sitting on the base slab rather than overlapping it, so nothing z-fights.
#   * `box` is CENTRE-based in z; `cyl` spans z=[cz-h, cz] and `pyr` follows the
#     same rule, so for those the authored cz is the TOP.
#   * `texSlot` is a BARE POSITIONAL after rot, not `texSlot=`.
#   * Stepped pyramid tiers rise exactly 1.0 (kStepHeight) so they are walked,
#     never jumped.
#   * Every zone carries an explicit, world-unique name=.
#   * Ambient weather: add a `particles <type> <density> <speed> <r> <g> <b>
#     <windX> <windZ>` line below to demo it (1=snow 2=rain 3=void 4=psychic). It
#     is left out here because it applies to the WHOLE world, interiors included.
#   * The wind demo borrows a foliage model from World_endless_snow rather than
#     duplicating a binary into this world; see the WindZone section.

# ==============================================================================
# Base slabs (top z=0), butted rather than overlapped.
# ==============================================================================
add box 10 -2.5 -0.25 60 0.5 95 0 1        # facility slab, y -50..45
add box 20 -71 -0.25 46 0.5 42 0 5         # outdoor grass, butts at y=-50
add box 59 0 -0.25 38 0.5 56 0 texPath=GameData/Tex/Tileset/Egypt/eg_mainstone_01.png texScaleU=12 texScaleV=18           # arena slab, butts at x=40

# ==============================================================================
# Chamber floors as inlays, 0.4 proud and clear of the slab top.
# ==============================================================================
add box 0 10 0.25 15 0.4 15 0 1           # Room 1
add box 20 10 0.25 15 0.4 15 0 1          # Room 2
add box 20 -10 0.25 15 0.4 15 0 1         # Room 3
add box 0 -10 0.25 15 0.4 15 0 1          # Room 4
add box 20 -38 0.25 23 0.4 23 0 1         # Great Hall
add box 59 0 0.1 36 0.4 52 0 texPath=GameData/Tex/Tileset/Egypt/eg_mainstone_04.png texScaleU=9 texScaleV=13            # arena paving inlay

# ==============================================================================
# ROOM 1 (NW) - lobby. North wall is split to carve the Dust_Ravine portal; the
# opening is 5.5 tall (above the 5.25 jump apex) so a jump in the doorway is not
# jammed by the surround above it.
# ==============================================================================
add box -5.25 17.75 4 4.5 8 0.5 0 2       # north wall, west of the portal gap
add box 5.25 17.75 4 4.5 8 0.5 0 2        # north wall, east of the gap
add box 0 17.75 6.75 6 2.5 0.5 0 2        # portal surround, z 5.5..8.0
add box -5 2.25 4 5 8 0.5 0 2              # south wall, west
add box 5 2.25 4 5 8 0.5 0 2               # south wall, east
add box 7.75 15 4 0.5 8 5 0 2             # east wall, upper
add box 7.75 5 4 0.5 8 5 0 2              # east wall, lower
add box -7.75 10 4 0.5 8 15 0 2           # west wall
add box 0 10 8.25 15 0.5 15 0 4           # ceiling
add cyl 0 10 8 0.8 0.8 8 16 0 3           # support column, spans z 0..8
add cyl 0 10 8.4 1.1 1.1 0.8 16 0 3       # capital

# ==============================================================================
# ROOM 2 (NE)
# ==============================================================================
add box 20 17.75 4 15 8 0.5 0 2
add box 15 2.25 4 5 8 0.5 0 2
add box 25 2.25 4 5 8 0.5 0 2
add box 27.75 10 4 0.5 8 15 0 2
add box 12.25 15 4 0.5 8 5 0 2
add box 12.25 5 4 0.5 8 5 0 2
add box 20 10 8.25 15 0.5 15 0 4
add cyl 20 10 8 0.8 0.8 8 16 0 3
add cyl 20 10 8.4 1.1 1.1 0.8 16 0 3

# ==============================================================================
# ROOM 3 (SW hub)
# ==============================================================================
add box 15 -2.75 4 5 8 0.5 0 2
add box 25 -2.75 4 5 8 0.5 0 2
add box 15 -17.75 4 5 8 0.5 0 2
add box 25 -17.75 4 5 8 0.5 0 2
add box 27.75 -10 4 0.5 8 15 0 2
add box 12.25 -5 4 0.5 8 5 0 2
add box 12.25 -15 4 0.5 8 5 0 2
add box 20 -10 8.25 15 0.5 15 0 4
add cyl 20 -10 8 0.8 0.8 8 16 0 3
add cyl 20 -10 8.4 1.1 1.1 0.8 16 0 3

# ==============================================================================
# ROOM 4 (SE) - flooded test chamber
# ==============================================================================
add box -5 -2.75 4 5 8 0.5 0 2
add box 5 -2.75 4 5 8 0.5 0 2
add box 0 -17.75 4 15 8 0.5 0 2
add box 7.75 -5 4 0.5 8 5 0 2
add box 7.75 -15 4 0.5 8 5 0 2
add box -7.75 -10 4 0.5 8 15 0 2
add box 0 -10 8.25 15 0.5 15 0 4
add cyl 0 -10 8 0.8 0.8 8 16 0 3
add cyl 0 -10 8.4 1.1 1.1 0.8 16 0 3
# Sump the water zone sits in: a shallow recessed pan so the flood reads
add box 0 -10 0.05 9 0.5 9 0 2

# ==============================================================================
# GREAT HALL - with a ceiling atrium over a raised dais and a taller finial now
# that the storey is 8 tall.
# ==============================================================================
add box 13 -26.75 4 9 8 0.5 0 2
add box 27 -26.75 4 9 8 0.5 0 2
add box 12 -49.75 4 9 8 0.5 0 2           # south wall west, gap x 16.5..23.5
add box 28 -49.75 4 9 8 0.5 0 2           # south wall east
add box 20 -49.75 6.75 7 2.5 0.5 0 2      # exit surround, z 5.5..8.0
# ^ centred x=20. It used to be `add box 0 -49.75 3.75 7 0.5 0.5`, i.e. centred
#   on x=0 - 20 units west of the gap it was supposed to head, so it floated
#   inside the west wall segment and the exit read as an unheaded hole.
add box 31.75 -38 4 0.5 8 23 0 2
add box 8.25 -38 4 0.5 8 23 0 2
# Atrium dais under the ceiling gap, reached by a 1.0 step
add box 20 -38 0.75 11 1.5 11 0 2         # dais, top z=1.5
add box 20 -32 0.5 11 1 1 0 1              # step up to the dais
add cyl 20 -38 6.5 0.9 0.9 5 16 0 3       # dais finial, spans 1.5..6.5
# Ceiling in two slabs, leaving a 6-wide atrium over the dais
add box 12.75 -38 8.25 8.5 0.5 23 0 4
add box 27.25 -38 8.25 8.5 0.5 23 0 4
# Colonnade
add cyl 12 -30 8 0.8 0.8 8 16 0 3
add cyl 28 -30 8 0.8 0.8 8 16 0 3
add cyl 12 -46 8 0.8 0.8 8 16 0 3
add cyl 28 -46 8 0.8 0.8 8 16 0 3

# ==============================================================================
# Corridors A-E, all roofed at 8.0.
# ==============================================================================
# A: Rooms 1 <-> 2 (east-west)
add box 10 12.75 4 5 8 0.5 0 2
add box 10 7.25 4 5 8 0.5 0 2
add box 10 10 8.25 5 0.5 5 0 4

# B: Rooms 1 <-> 4 (north-south)
add box 2.75 0 4 0.5 8 5 0 2
add box -2.75 0 4 0.5 8 5 0 2
add box 0 0 8.25 5 0.5 5 0 4

# C: Rooms 2 <-> 3 (north-south) - its EAST wall is deliberately absent, so the
#    passage opens into the pocket and on into the arena corridor at x=28.
add box 17.25 0 4 0.5 8 5 0 2
add box 22.5 0 8.25 10 0.5 5 0 4          # ceiling spans corridor + pocket

# D: Rooms 3 <-> 4 (north-south)
add box 10 -7.25 4 5 8 0.5 0 2
add box 10 -12.75 4 5 8 0.5 0 2
add box 10 -10 8.25 5 0.5 5 0 4

# E: Great Hall <-> Room 3 (north-south)
add box 22.75 -22 4 0.5 8 9 0 2
add box 17.25 -22 4 0.5 8 9 0 2
add box 20 -22 8.25 5 0.5 9 0 4

# ==============================================================================
# EAST CORRIDOR - the facility's only link to the arena, 5 wide at y -2.5..2.5.
# It runs through what used to be dead space between the chambers and the east
# shell; corridor C's missing east wall is what connects it to the facility.
# ==============================================================================
add box 34 2.75 4 12 8 0.5 0 2            # north wall, x 28..40
add box 34 -2.75 4 12 8 0.5 0 2           # south wall
add box 34 0 8.25 12 0.5 5 0 4            # ceiling
add box 34 0 0.25 12 0.4 5 0 1            # floor inlay so the route reads

# ==============================================================================
# OUTDOOR COURTYARD (south of the Great Hall). Perimeter walls are 3.5 tall so
# they enclose a 3-tall player and block; they are walked over at 1.0 and read
# as curbs at 2.0.
# ==============================================================================
add box 20 -49.75 0.25 12 0.4 1 0 1      # threshold inlay
add box 20 -55 0.25 6 0.4 10 0 1         # walkway inlay
add box 12 -62 1.75 12 3.5 18 0 2
add box 28 -62 1.75 12 3.5 18 0 2
add box 12 -75 1.75 12 3.5 8 0 2
add box 28 -75 1.75 12 3.5 8 0 2
add box 20 -78.5 1.75 12 3.5 1 0 2         # far wall
add box 4 -62 1.75 4 3.5 26 0 2            # west side wall
add box 36 -62 1.75 4 3.5 26 0 2           # east side wall
add box 20 -66 0.25 28 0.4 24 0 1           # courtyard paving inlay
# Walkway jambs and their pergola roof. The jambs are h=8 and the roof sits at
# 8.0, NOT the 4.0 it used to: at 4.0 you could stand on the jamb tops (4.0 is a
# 2.25 jump from the floor plus a step) and a jump under the roof was jammed by
# it, the same trap as the interiors.
add box 16 -55 4.5 2 9 7 0 2
add box 24 -55 4.5 2 9 7 0 2
add box 20 -52 9.25 8 0.5 4 0 4
# Tall courtyard pillars (open sky above - nothing to jam against)
add cyl 12 -55 6 0.5 0.5 6 16 0 3
add cyl 28 -55 6 0.5 0.5 6 16 0 3
add cyl 12 -72 6 0.5 0.5 6 16 0 3
add cyl 28 -72 6 0.5 0.5 6 16 0 3
# Planters / benches
add box 20 -66 0.9 6 1.8 2 0 3
add box 20 -70 0.9 6 1.8 2 0 3

# ==============================================================================
# ARENA (east) - the showcase wing: a stepped pyramid, a glowing apex, a tapered
# obelisk and colonnade, a brazier court, and a watchtower reached only by a
# ladder. Open to the sky, so its tall pieces are safe by the clearance rule.
# ==============================================================================
# --- Enclosure ---
add box 59 28 4 38 8 1 0 texPath=GameData/Tex/Tileset/Egypt/eg_egutt_wall_01.png texScaleU=8 texScaleV=2                # north wall
add box 59 -28 4 38 8 1 0 texPath=GameData/Tex/Tileset/Egypt/eg_egutt_wall_02.png texScaleU=8 texScaleV=2               # south wall
add box 78 -18 4 1 8 20 0 texPath=GameData/Tex/Tileset/Egypt/eg_egutt_wall_02.png texScaleU=3 texScaleV=2   # east wall, south of the gate
add box 78 18 4 1 8 20 0 texPath=GameData/Tex/Tileset/Egypt/eg_egutt_wall_02.png texScaleU=3 texScaleV=2    # east wall, north of the gate
add box 78 0 6.75 1 2.5 16 0 texPath=GameData/Tex/Tileset/Egypt/eg_egutt_wall_01.png texScaleU=2 texScaleV=1 # gate lintel, opening z 0..5.5                 # east wall
add box 40 15.25 4 1 8 25.5 0 texPath=GameData/Tex/Tileset/Egypt/eg_egutt_wall_03.png texScaleU=5 texScaleV=2           # west wall, north of the doorway
add box 40 -15.25 4 1 8 25.5 0 texPath=GameData/Tex/Tileset/Egypt/eg_egutt_wall_04.png texScaleU=5 texScaleV=2          # west wall, south of the doorway
add box 40 0 6.75 1 2.5 5 0 texPath=GameData/Tex/Tileset/Egypt/eg_egutt_wall_01.png texScaleU=1 texScaleV=1             # doorway surround, opening z 0..5.5
# Facility east edge, above and below the arena's span, so the slab edge is not
# an open drop into the void between the two slabs.
add box 40 36.5 4 1 8 17 0 texPath=GameData/Tex/Tileset/Egypt/eg_egutt_wall_05.png texScaleU=5 texScaleV=2
add box 40 -39 4 1 8 22 0 texPath=GameData/Tex/Tileset/Egypt/eg_egutt_wall_05.png texScaleU=5 texScaleV=2

# --- Stepped pyramid, 1.0 steps so it is WALKED, not jumped ---
add box 59 0 0.5 18 1 18 0 texPath=GameData/Tex/Tileset/Egypt/eg_mainpyramid_01.png texScaleU=6 texScaleV=6
add box 59 0 1.5 15 1 15 0 texPath=GameData/Tex/Tileset/Egypt/eg_mainpyramid_02.png texScaleU=5 texScaleV=5
add box 59 0 2.5 12 1 12 0 texPath=GameData/Tex/Tileset/Egypt/eg_mainpyramid_03.png texScaleU=4 texScaleV=4
add box 59 0 3.5 9 1 9 0 texPath=GameData/Tex/Tileset/Egypt/eg_mainpyramid_04.png texScaleU=3 texScaleV=3
add box 59 0 4.5 6 1 6 0 texPath=GameData/Tex/Tileset/Egypt/eg_mainpyramid_01.png texScaleU=2 texScaleV=2
add box 59 0 5.5 3 1 3 0 texPath=GameData/Tex/Tileset/Egypt/eg_mainpyramid_02.png texScaleU=1 texScaleV=1
# --- Glowing orb floating over the apex (SURF_GLOW; see the flag table) ---
sph 59 0 7.2 1.0 24 flags=16384 surfGlow=(1.0,0.75,0.25) surfGlowScale=1.6
# --- Tapered obelisk behind the pyramid: rTop 0.3 vs rBot 1.6 ---
add cyl 59 22 14 0.3 1.6 14 16 0 texPath=GameData/Tex/Tileset/Egypt/eg_maineaglestone.png texScaleU=2 texScaleV=4
# --- Tapered colonnade (the other three corners) ---
add cyl 44 -22 8 0.35 0.6 8 14 0 texPath=GameData/Tex/Tileset/Egypt/eg_mainstone_04.png texScaleU=2 texScaleV=3
add cyl 44 22 8 0.35 0.6 8 14 0 texPath=GameData/Tex/Tileset/Egypt/eg_mainstone_04.png texScaleU=2 texScaleV=3
add cyl 74 -22 8 0.35 0.6 8 14 0 texPath=GameData/Tex/Tileset/Egypt/eg_mainstone_04.png texScaleU=2 texScaleV=3

# --- Brazier pedestals (the fire itself is a ParticleEmitter below) ---
add cyl 49 -9 1.5 0.45 0.6 1.5 12 0 texPath=GameData/Tex/Tileset/Egypt/eg_mainstone_01.png texScaleU=1 texScaleV=1
add cyl 69 -9 1.5 0.45 0.6 1.5 12 0 texPath=GameData/Tex/Tileset/Egypt/eg_mainstone_01.png texScaleU=1 texScaleV=1
add cyl 49 9 1.5 0.45 0.6 1.5 12 0 texPath=GameData/Tex/Tileset/Egypt/eg_mainstone_01.png texScaleU=1 texScaleV=1
add cyl 69 9 1.5 0.45 0.6 1.5 12 0 texPath=GameData/Tex/Tileset/Egypt/eg_mainstone_01.png texScaleU=1 texScaleV=1

# --- Watchtower: solid body, platform on top, ladder up its west face ---
add box 74 22 4 5 8 5 0 texPath=GameData/Tex/Tileset/Egypt/eg_egutt_wall_06.png texScaleU=2 texScaleV=3
add box 74 22 8.5 5 1 5 0 texPath=GameData/Tex/Tileset/Egypt/eg_mainstone_02.png texScaleU=2 texScaleV=2               # platform, top z=9

# --- Surface showcases ---
# Brush-wide glow: a light strip along the north wall base
add box 59 27.2 0.3 30 0.6 0.4 0 3 flags=16384 surfGlow=(0.35,0.8,1.0) surfGlowScale=1.4
# PER-FACE glow: only the top of this pad is lit, its sides are not
add box 45 8 0.2 5 0.4 5 0 3 facePy_flags=16384 facePy_glow=(0.35,1.0,0.55)
# Oriented plane: a vertical banner on the facility's east face. NO_BSP_CUTS
# (1<<28) because collision is AABB-only and a flat 10x10 quad would otherwise
# block as a solid slab across the doorway approach.
add pln 41 -12 6 1 0 0 0 flags=268435456 texPath=oztex/tileset/04_ceiling_tech_128.png texScaleU=2 texScaleV=2

# --- Mesh showcase ---
# A prop on a pedestal: Med_01 is 0.5u wide, so scale 3 makes it 1.5u.
add cyl 45 0 1.2 0.9 1.1 1.2 12 0 3
Mesh.Static GameData/Tex/Global/Items/MedMeshes/Med_01.glb 45 0 1.2 0 scale=3.0
# A SKELETAL mesh playing a named clip (the weapon GLBs carry Idle/Fire/Reload
# from tools/merge_glb_anims.py). Rifle_01 is 0.83u long, so scale 3 is 2.5u.
add box 45 -14 1 3 2 1 0 3
Mesh.Skeletal GameData/Tex/Global/Gun/Rifle_01/Fbx_Files/Rifle_01.glb 45 -14 2.0 90 scale=3.0 anim=Idle

# --- Wind demo: trees with wind=1 inside the WindZone below ---
# BORROWED from World_endless_snow rather than copying a binary into this world.
# build-data.ps1 packs world models nowhere, so GameData paths resolve at runtime
# from the loose tree, and worldcheck checks the reference like any other.
# Pines rather than that world's winter bushes: the bushes are pale, scraggly and
# read as flat cards in a stone arena, and a tree is what makes wind sway legible.
# The pine's origin sits ~2u above its base, so z=0 buries the root ball - which
# is how World_endless_snow places them, and the trunk above ground is 5-6u.
Mesh.Static GameData/Worlds/World_endless_snow/Models/forest/forest_pine_1.glb 44 -24 0 0 wind=1 scale=1.2 tex=GameData/Tex/Global/EFX/tree_pine_needles.png
Mesh.Static GameData/Worlds/World_endless_snow/Models/forest/forest_pine_2.glb 74 -24 0 30 wind=1 scale=1.3 tex=GameData/Tex/Global/EFX/tree_pine_needles.png
Mesh.Static GameData/Worlds/World_endless_snow/Models/forest/forest_pine_2.glb 44 24 0 200 wind=1 scale=1.15 tex=GameData/Tex/Global/EFX/tree_pine_needles.png
Mesh.Static GameData/Worlds/World_endless_snow/Models/forest/forest_pine_1.glb 64 24 0 150 wind=1 scale=1.25 tex=GameData/Tex/Global/EFX/tree_pine_needles.png


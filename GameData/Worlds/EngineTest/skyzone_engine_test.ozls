// Renamed zone (the world file now uses an explicit "engine_sky" name rather
// than the auto-generated "zone_sky_0", which collided between worlds).
entity "engine_sky" : skyzone {
    fog_color = (0.62, 0.66, 0.72)
    fog_density = 0.003
    ambient_light = (0.58, 0.58, 0.60)
    skybox = "GameData/Tex/Global/Sky/sky_day.png"
    actions {
        on_enter {
            set_fog 0.62 0.66 0.72 0.003
            set_ambient 0.58 0.58 0.60
            set_skybox "GameData/Tex/Global/Sky/sky_day.png"
            say "Engine Test - ambient, fog and skybox active"
        }
        on_exit {
            restore_fog
            restore_skybox
            say "Left the Engine Test sky zone"
        }
    }
}
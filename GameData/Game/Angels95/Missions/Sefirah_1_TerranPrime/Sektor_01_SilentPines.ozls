// Sektor_01_SilentPines — Sefirah 1 (Terran Prime). The act's opening district.
//
// Runtime consumers: GameManager (sector/world/mode/objectives/next),
// GameState (server objective seeding + the exit transition), and the client's
// mission-start/complete beats (LightningEntityManager's bus bridge resolves
// `mission.start` -> on_start, `mission.complete` -> on_complete).
//
// Completion is SPATIAL: the mission ends when the player leaves through this
// world's authored exit portal (the shrine, behind the altar), not when an
// objective counter fills. The objective is route guidance, not a toll.
entity "Sektor_01_SilentPines" : mission {
    stats {
        sector = Sefirah_1_TerranPrime
        world = Sektor_01_SilentPines
        mode = campaign
        objectives = Objective_S01_GorgeWatch
        next = Sektor_02_MegacityGrid
    }
    actions {
        on_start    { msg "Terran Prime. The gorge drops to a shrine — get down there alive." }
        on_complete { msg "Silent Pines is behind you. The grid is next." }
    }
}

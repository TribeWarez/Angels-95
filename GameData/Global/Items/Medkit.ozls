entity "Medkit" : consumable {
    icon = "GameData/Global/Items/HealthVial.png"
    // 3D world model (PSX MED pack). The GLB carries its own texture, so
    // `texture` is deliberately omitted - Mesh::Load would otherwise force one
    // diffuse across the material. mesh_scale trims the 0.5m asset to ~0.34m
    // on screen (pickups draw at a fixed 1.5x base). Swap the Med_NN index for
    // any of the 20 kits in GameData/Global/Items/MedMeshes/.
    mesh = "GameData/Global/Items/MedMeshes/Med_01.glb"
    mesh_type = "static"
    stats {
        value = 50
        respawn_time = 30.0
        pickup_category = "consumable"
        mesh_scale = 0.45
    }
    actions {
        on_use {
            playerstat health += 50
            msg "You kneel and bind your wounds. +50 health."
            play_sound "GameData/Audio/Sounds/UI/TalkingNoise.mp3"
            consume
        }
    }
}

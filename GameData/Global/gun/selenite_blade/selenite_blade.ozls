entity "selenite_blade" : weapon {
    mesh = "selenite_blade_lvl1.obj"
    texture = "selenite_blade_lvl1_texture.png"
    icon = "selenite_blade_icon.png"
    stats {
        damage = 40
        swing_speed = 0.8
        reach = 3.0
        stamina_cost = 15
        // This def had no viewmodel_* keys at all, so it fell back to ViewModel's
        // defaults: rot = 0 left the sword's 3.9-unit long axis vertical on
        // screen (~15x oversized at 0.45 units). The blade's long axis is Y, so
        // a Y yaw cannot fix it - it needs a 90 deg pitch about X to lay the
        // blade along screen depth.
        viewmodel_offset = (0.26, -0.30, 0.44)
        viewmodel_rot = (90, 0, 0)
        viewmodel_scale = 1.0
        // Melee sound stats.
        swing_sound = GameData/Audio/Sounds/Entities/boot2.wav
        swing_volume = 0.6
        swing_pitch = 1.2
    }
    actions {
        on_swing {
            say "Slash! (40 damage)"
            set_cooldown 0.8
        }
        on_hit {
            say "Blade connects!"
        }
    }
}

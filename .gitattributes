# Auto-detect text files and normalize line endings
* text=auto

# Shell scripts must stay LF
*.sh text eol=lf

# systemd units are installed on Linux (CRLF makes systemd reject the file)
*.service text eol=lf

# GitHub Actions / YAML config
*.yml text eol=lf
*.yaml text eol=lf

# PowerShell scripts — LF is conventional in git even on Windows
*.ps1 text eol=lf

# Makefile
Makefile text eol=lf

# Source code
*.cpp text eol=lf
*.hpp text eol=lf
*.h text eol=lf
*.c text eol=lf

# Config / data files
*.conf text eol=lf
*.wdl text eol=lf
*.json text eol=lf
*.txt text eol=lf
*.md text eol=lf
*.cfg text eol=lf

# Binary files — do not touch
*.png binary
*.jpg binary
*.jpeg binary
*.bmp binary
*.tga binary
*.dds binary
*.mp3 binary
*.wav binary
*.ogg binary
*.flac binary
*.mp4 binary
*.mpeg binary
*.mpg binary
*.mid binary
*.obj binary
*.sav binary
*.dll binary
*.exe binary
*.so binary
*.dylib binary
*.ico binary
*.ttf binary
*.otf binary
*.wrl binary
